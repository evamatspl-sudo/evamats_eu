    "e857fdc5-7358-4bf5-80d4-611e2484d845": {
      "type": "home-8",
      "disabled": true,
      "settings": {
        "hd": "<h1>Do jakiego <span>transportu? </span>\n</h1>",
        "des": "<p>We make stylish EVA mats for every kind of transport: cars, boats, aircraft and more. We offer solutions matched to the exact dimensions of your vehicle. Different patterns and top quality at an accessible price.</p>",
        "btn_text": "OBJEDNAT KOBEREC",
        "btn_url": "shopify://collections/all-car-mats"
      }
    },
    "c605d8f3-dc8c-4614-8c41-de8a728399a1": {
      "type": "collapsible-content",
      "blocks": {
        "template--18288166109490__c605d8f3-dc8c-4614-8c41-de8a728399a1-1679587212fe76a58e-0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is EVA material?",
            "icon": "none",
            "row_content": "<p>EVA is ethylene-vinyl acetate, a light and flexible material with water-resistant properties.<br/>Because it is hypoallergenic, the mats give off no odour even at high temperatures.</p>",
            "page": ""
          }
        },
        "template--18288166109490__c605d8f3-dc8c-4614-8c41-de8a728399a1-1679587212fe76a58e-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I fit EVA mats correctly?",
            "icon": "none",
            "row_content": "<p>Every set has a defined type of fastening — we have more than 30 types. We fit the fasteners in the right places and additionally sew hook-and-loop strips along the sides so the mats do not slide and stay in place.</p>",
            "page": ""
          }
        },
        "template--18288166109490__c605d8f3-dc8c-4614-8c41-de8a728399a1-1679587212fe76a58e-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Need a one-off mat?",
            "icon": "none",
            "row_content": "<p>We can make a separate mat for a gas cylinder if it protrudes into the boot, or cover a larger area of the floor in specific places at the customer's request.</p>",
            "page": ""
          }
        },
        "template--18288166109490__c605d8f3-dc8c-4614-8c41-de8a728399a1-1679587212fe76a58e-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Lze prát koberce z materiálu EVA?",
            "icon": "none",
            "row_content": "<p>Yes, the mats can be cleaned with a soft sponge and detergent. We do not recommend using aggressive chemical cleaners.</p>",
            "page": ""
          }
        },
        "4585ff0f-b735-4703-9e3f-52b91d99c12d": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do the mats come with a warranty?",
            "icon": "none",
            "row_content": "<p>We provide a one-year warranty from the date the mats are received, which allows the set to be exchanged within one year in case of deformation or abrasion. Thanks to the quality of the material, however, the mats last 5–7 years.</p>",
            "page": ""
          }
        }
      },
