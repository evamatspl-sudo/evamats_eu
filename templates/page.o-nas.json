      "settings": {
        "media_type": "carousel",
        "heading": "Carvion started from nothing — from handwork and full attention to every detail, to a refined system that now sets the quality standard.",
        "body": "<p>That experience taught us one thing: a product only makes sense when it works in everyday use.</p><p>That is why we make car mats that genuinely match a specific vehicle and the driver's needs — taking into account structural differences, conditions of use and long-term durability. Every element has a purpose and every production step is controlled, because the final result is not a matter of chance.</p><p>It is not only about the product itself.<br/> It is about how it changes the everyday experience of driving — more order, more comfort, fewer compromises.</p><p>Because for us, driver comfort is not an add-on.<br/> <strong>It is the standard.</strong></p>",
        "trust_label": "50k+ drivers",
        "badge_faces_image": "shopify://shop_images/Group_1632523139.webp",
        "padding_top": 40,
        "padding_bottom": 48
      }
    },
    "o_nas_story": {
      "type": "o-nas-story-slider",
      "blocks": {
        "ons_s1": {
          "type": "slide",
          "settings": {
            "heading": "Measuring and templates",
            "body": "<p>Precision starts with the basics<br/>We analyse every model individually — taking real structural differences into account.<br/><br/>We create templates from real measurements so they fit a specific car perfectly.</p>",
            "image": "shopify://shop_images/carvion-about-01-measurement-worker-v7-20260730.webp"
          }
        },
        "slide_thzice": {
          "type": "slide",
          "settings": {
            "heading": "CNC cutting",
            "body": "<p>Precision at technology level<br/>We use precise CNC machines that copy the shape perfectly.<br/><br/>Every cut is repeatable and exact — no deviations, no compromises.</p>",
            "image": "shopify://shop_images/carvion-about-02-cnc-cutting.webp"
          }
        },
        "slide_Pg7tBp": {
          "type": "slide",
          "settings": {
            "heading": "Stitching and 3D forming",
            "body": "<p>Function meets form<br/>Stitching and edges add durability and good looks.<br/><br/>3D forming makes the mat sit tight to the floor and protects the car interior.<br/></p>",
            "image": "shopify://shop_images/carvion-about-03-binding-shaping.webp"
          }
        },
        "slide_AkUN7b": {
          "type": "slide",
          "settings": {
            "heading": "Quality control",
            "body": "<p>Every detail matters<br/>Every set goes through a careful inspection.<br/><br/>We check the fit, the workmanship and the final finish — before it reaches the customer.</p>",
            "image": "shopify://shop_images/carvion-about-04-quality-control.webp"
          }
        },
        "slide_yNFpU9": {
          "type": "slide",
          "settings": {
            "heading": "Packing and dispatch",
            "body": "<p>Ready for everyday use<br/>Safe packaging and reliable logistics.<br/><br/>The product arrives in perfect condition — ready to do its job straight away.</p>",
            "image": "shopify://shop_images/carvion-about-05-packing-logo-final-20260730.webp"
          }
        }
