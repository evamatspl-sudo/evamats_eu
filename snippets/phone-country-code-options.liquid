{%- comment -%}
  European dialing codes for phone prefix select.

  Default prefix follows the storefront language:
    cs → +420 (CZ)   de → +49 (DE)   sk → +421 (SK)
    pl → +48 (PL)    fr → +33 (FR)   it → +39 (IT)   es → +34 (ES)
    everything else  → +420

  Optional param: selected (e.g. '+420').
  Legacy/stale values ('+42' — the defunct Czechoslovak code — and a blank value)
  are ignored and replaced by the language default.
{%- endcomment -%}
{%- liquid
  assign locale_code = request.locale.iso_code

  case locale_code
    when 'cs'
      assign default_code = '+420'
    when 'de'
      assign default_code = '+49'
    when 'sk'
      assign default_code = '+421'
    when 'pl'
      assign default_code = '+48'
    when 'fr'
      assign default_code = '+33'
    when 'it'
      assign default_code = '+39'
    when 'es'
      assign default_code = '+34'
    else
      assign default_code = '+420'
  endcase

  assign selected_code = selected | default: '' | strip

  if selected_code == blank or selected_code == '+42'
    assign selected_code = default_code
  endif

  assign dial_codes = '+30,+31,+32,+33,+34,+36,+39,+40,+41,+43,+44,+45,+46,+47,+48,+49,+351,+358,+359,+370,+371,+372,+385,+386,+420,+421,+423' | split: ','
-%}
{%- for dial_code in dial_codes -%}
<option value="{{ dial_code }}"{% if selected_code == dial_code %} selected{% endif %}>{{ dial_code }}</option>
{%- endfor -%}
