{% comment %}Eight existing imports, unchanged authors/photos. No fabricated totals, dates or schema. Preview only.{% endcomment %}
<section class="cz-cro-reviews page-width{% if full_page %} cz-cro-reviews--page{% endif %}" id="cz-cro-reviews" aria-labelledby="cz-cro-reviews-title" tabindex="-1" data-cz-cro-preview>
  <div class="cz-cro-reviews-heading">
    <div>
      {% if full_page %}
        <img class="cz-cro-review-logo" src="{{ 'logo_carvion_inverse.svg' | file_url }}" width="140" height="52" alt="Carvion">
        <h1 id="cz-cro-reviews-title">{{ 'carvion_cro.reviews_page_title' | t }}</h1>
      {% else %}
        <h2 id="cz-cro-reviews-title">{{ 'carvion_cro.reviews_title' | t }}</h2>
      {% endif %}
      <p>{{ 'carvion_cro.reviews_lead' | t }}</p>
    </div>
    {% unless full_page %}<a class="cz-cro-source-link" href="{{ pages['reviews'].url }}">{{ 'carvion_cro.all_reviews' | t }} <span aria-hidden="true">→</span></a>{% endunless %}
  </div>
  <div class="cz-cro-google-summary">
    <span class="cz-cro-google-label">{% render 'carvion-google-mark' %}{{ 'carvion_cro.google_reviews' | t }}</span>
    <a class="cz-cro-source-link" href="https://www.google.com/maps/search/?api=1&amp;query=Carvion&amp;query_place_id=ChIJMeAerT1z_UYRiKoMeCumjD4" target="_blank" rel="noopener noreferrer">{{ 'carvion_cro.google_profile' | t }} <span aria-hidden="true">↗</span></a>
  </div>
  <p class="cz-cro-preview-note">{{ 'carvion_cro.preview_note' | t }}</p>
  {% unless full_page %}
    <div class="cz-cro-review-controls" hidden data-cz-cro-controls>
      <button type="button" data-cz-cro-slide="-1" aria-controls="cz-cro-review-grid" aria-label="{{ 'carvion_cro.previous' | t | escape }}">←</button>
      <span data-cz-cro-position aria-live="polite">1 / 8</span>
      <button type="button" data-cz-cro-slide="1" aria-controls="cz-cro-review-grid" aria-label="{{ 'carvion_cro.next' | t | escape }}">→</button>
    </div>
  {% endunless %}
  <div class="cz-cro-review-grid" id="cz-cro-review-grid" {% unless full_page %}tabindex="0" aria-label="{{ 'carvion_cro.reviews_link' | t | escape }}"{% endunless %}>{% render 'carvion-cro-review-cards' %}</div>
</section>
