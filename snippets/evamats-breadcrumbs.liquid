{%- comment -%}
  Breadcrumbs for product and collection pages.

  Explicit mode:
  @param parent_label, parent_url, middle_label, middle_url, current_label, class

  Product mode:
  @param auto_product {boolean}
{%- endcomment -%}

{%- liquid
  assign bc_parent_label = parent_label
  assign bc_parent_url = parent_url
  assign bc_middle_label = middle_label
  assign bc_middle_url = middle_url
  assign bc_current_label = current_label
  assign bc_catalog_label = blank
  assign bc_catalog_url = blank
  assign bc_brand_label = blank
  assign bc_brand_url = blank
  assign bc_model_label = blank
  assign bc_model_url = blank

  if auto_product and product != blank
    assign bc_parent_label = 'Carvion'
    assign bc_parent_url = routes.root_url
    assign bc_current_label = product.title

    case request.locale.iso_code
      when 'cs'
        assign bc_catalog_label = 'Katalog'
      when 'de'
        assign bc_catalog_label = 'Katalog'
      else
        assign bc_catalog_label = 'Catalog'
    endcase

    assign bc_catalog_url = pages['car-brands'].url
    if bc_catalog_url == blank
      assign bc_catalog_url = routes.all_products_collection_url
    endif

    assign breadcrumb_model_collection = blank
    for product_collection in product.collections
      if product_collection.template_suffix contains '-model'
        assign breadcrumb_model_collection = product_collection
        break
      endif
    endfor

    if breadcrumb_model_collection != blank
      assign bc_model_label = breadcrumb_model_collection.title
      assign bc_model_label = bc_model_label | remove: 'Car mats EVA for ' | remove: 'Autokoberce EVA pro ' | remove: 'EVA-Automatten für ' | strip
      assign bc_model_url = breadcrumb_model_collection.url

      assign brand_handle = breadcrumb_model_collection.template_suffix | remove: '-model' | replace: '_', '-'
      assign breadcrumb_brand_collection = collections[brand_handle]
      if breadcrumb_brand_collection != blank
        assign bc_brand_label = breadcrumb_brand_collection.title
        assign bc_brand_label = bc_brand_label | remove: 'Car mats EVA for ' | remove: 'Autokoberce EVA pro ' | remove: 'EVA-Automatten für ' | remove: ' floor mats - which ones to choose?' | remove: ' car mats - which ones to choose?' | strip
        assign bc_brand_url = breadcrumb_brand_collection.url
      endif
    endif
  endif
-%}

{%- if bc_current_label != blank -%}
  <nav class="evamats-breadcrumbs{% if class != blank %} {{ class }}{% endif %}" aria-label="Breadcrumb">
    <ol class="evamats-breadcrumbs__list">
      {%- if bc_parent_label != blank -%}
        <li class="evamats-breadcrumbs__item">
          <a class="evamats-breadcrumbs__link" href="{{ bc_parent_url }}">{{ bc_parent_label | escape }}</a>
        </li>
        <li class="evamats-breadcrumbs__item evamats-breadcrumbs__item--sep" aria-hidden="true"></li>
      {%- endif -%}

      {%- if auto_product and bc_catalog_label != blank -%}
        <li class="evamats-breadcrumbs__item">
          <a class="evamats-breadcrumbs__link" href="{{ bc_catalog_url }}">{{ bc_catalog_label | escape }}</a>
        </li>
        <li class="evamats-breadcrumbs__item evamats-breadcrumbs__item--sep" aria-hidden="true"></li>
      {%- elsif bc_middle_label != blank -%}
        <li class="evamats-breadcrumbs__item">
          <a class="evamats-breadcrumbs__link" href="{{ bc_middle_url }}">{{ bc_middle_label | escape }}</a>
        </li>
        <li class="evamats-breadcrumbs__item evamats-breadcrumbs__item--sep" aria-hidden="true"></li>
      {%- endif -%}

      {%- if bc_brand_label != blank -%}
        <li class="evamats-breadcrumbs__item">
          <a class="evamats-breadcrumbs__link" href="{{ bc_brand_url }}">{{ bc_brand_label | escape }}</a>
        </li>
        <li class="evamats-breadcrumbs__item evamats-breadcrumbs__item--sep" aria-hidden="true"></li>
      {%- endif -%}

      {%- if bc_model_label != blank -%}
        <li class="evamats-breadcrumbs__item">
          <a class="evamats-breadcrumbs__link" href="{{ bc_model_url }}">{{ bc_model_label | escape }}</a>
        </li>
        <li class="evamats-breadcrumbs__item evamats-breadcrumbs__item--sep" aria-hidden="true"></li>
      {%- endif -%}

      <li class="evamats-breadcrumbs__item">
        <span class="evamats-breadcrumbs__current" aria-current="page">{{ bc_current_label | escape }}</span>
      </li>
    </ol>
  </nav>
{%- endif -%}
