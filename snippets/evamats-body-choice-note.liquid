{%- comment -%}
  Пометка на карточке товара: «кузов выбирается внутри конфигуратора».
  Показывается только если заполнено custom.custom_list_body_type_in_config
  (список метаобъектов body_types). Перечисляет доступные кузова на языке витрины.
  Параметр: product
{%- endcomment -%}

{%- assign body_list = product.metafields.custom.custom_list_body_type_in_config.value -%}
{%- if body_list != blank and body_list.size > 0 -%}
  {%- liquid
    case request.locale.iso_code
      when 'cs'
        assign note_text = 'Karoserii vyberete přímo v konfigurátoru níže.'
        assign note_label = 'Dostupné karoserie:'
      when 'de'
        assign note_text = 'Die Karosserie wählen Sie direkt im Konfigurator unten.'
        assign note_label = 'Verfügbare Karosserien:'
      when 'lv'
        assign note_text = 'Virsbūves tipu izvēlieties tieši zemāk esošajā konfiguratorā.'
        assign note_label = 'Pieejamie virsbūves tipi:'
      else
        assign note_text = 'You choose the body type directly in the configurator below.'
        assign note_label = 'Available body types:'
    endcase
  -%}

  {{ 'component-evamats-body-choice-note.css' | asset_url | stylesheet_tag }}
  <div class="eva-body-choice-note">
    <span class="eva-body-choice-note__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 16v2M19 16v2"/>
        <path d="M3 16v-3.2a2 2 0 0 1 .2-.9l2-4A2 2 0 0 1 7 6.8h10a2 2 0 0 1 1.8 1.1l2 4c.13.28.2.58.2.9V16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/>
        <path d="M6.5 13h11"/>
      </svg>
    </span>
    <div class="eva-body-choice-note__body">
      <p class="eva-body-choice-note__text">{{ note_text }}</p>
      <p class="eva-body-choice-note__list">
        <span class="eva-body-choice-note__label">{{ note_label }}</span>
        {%- for body_object in body_list -%}
          {%- liquid
            assign handle = body_object.system.handle | downcase
            assign body_label = body_object.title.value | default: handle
          -%}
          <span class="eva-body-choice-note__chip">{{ body_label }}</span>
        {%- endfor -%}
      </p>
    </div>
  </div>
{%- endif -%}
