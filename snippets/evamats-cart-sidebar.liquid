{% comment %}
  Cart summary sidebar — Figma 1710:11244 desktop / 1710:10859 mobile
{% endcomment %}
<aside class="evamats-cart-sidebar" aria-label="{{ 'sections.cart.caption' | t }}">
  <div class="evamats-cart-sidebar__head">
    <p class="evamats-cart-sidebar__count">
      {{ 'sections.cart.items_in_cart_html' | t: count: cart.item_count }}
    </p>
    <button type="button" class="evamats-cart-sidebar__clear" data-clear-cart>
      <span class="evamats-cart-sidebar__clear-icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </span>
      <span>{{ 'sections.cart.clear_cart' | t }}</span>
    </button>
  </div>

  <div class="evamats-cart-sidebar__reservation">
    <span class="evamats-cart-sidebar__reservation-icon" aria-hidden="true">
      {%- render 'evamats-cart-reservation-lock-icon' -%}
    </span>
    <div class="evamats-cart-sidebar__reservation-body">
      <p class="evamats-cart-sidebar__reservation-text">{{ 'sections.cart.reservation_sidebar_text' | t }}</p>
      <p class="evamats-cart-sidebar__timer" id="countdown-timer" aria-live="polite">10:00</p>
      <button id="extend-button" class="evamats-cart-sidebar__extend button" type="button" style="display:none;">
        {{ 'sections.cart.reservation_button' | t }}
      </button>
    </div>
  </div>

  <div class="evamats-cart-sidebar__totals">
    <span class="evamats-cart-sidebar__total-label">{{ 'sections.cart.headings.total' | t }}</span>
    <span class="evamats-cart-sidebar__total-value bcpo-cart-original-total">{{ cart.total_price | money_with_currency }}</span>
  </div>

  <div id="discountMessage" class="evamats-cart-sidebar__discounts">
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
        {%- for discount in cart.cart_level_discount_applications -%}
          <li class="discounts__discount discounts__discount--position">
            {%- render 'icon-discount' -%}
            {{ discount.title }}
            (-{{ discount.total_allocated_amount | money }})
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="evamats-cart-sidebar__actions">
    <label class="evamats-cart-sidebar__terms checkbox-container">
      {{ 'sections.application_form.privacy_text_html' | t }}
      <input type="checkbox" id="evamats-cart-terms-checkbox" data-cart-terms-checkbox required>
      <span class="checkmark"></span>
    </label>
    <span class="message_text hidden">{{ 'general.config.warning_message' | t }}</span>
    <div id="message" class="evamats-cart-sidebar__message"></div>

    <button
      type="submit"
      id="checkout"
      class="evamats-cart-sidebar__checkout cart__checkout-button button button_2"
      name="checkout"
      form="cart"
      disabled
    >
      {{ 'sections.cart.checkout' | t }}
    </button>

    {%- comment -%} Express-wallet buttons (Shop Pay / PayPal / GPay) hidden in cart drawer per owner request (2026-07) — kept only the standard checkout button above.
    {%- if additional_checkout_buttons -%}
      <div class="evamats-cart-sidebar__dynamic-checkout cart__dynamic-checkout-buttons additional-checkout-buttons">
        {{ content_for_additional_checkout_buttons }}
      </div>
    {%- endif -%}
    {%- endcomment -%}
  </div>

  <div id="cart-errors" class="evamats-cart-sidebar__errors"></div>
</aside>

{%- comment -%}
  Согласие: кнопка «К оплате» была просто disabled, поэтому клик не давал никакого
  отклика и предупреждение (.message_text) никогда не показывалось. Теперь кнопка
  остаётся заблокированной по смыслу (aria-disabled), но клик перехватывается и
  выводит подсказку. Без JS кнопка остаётся disabled, как раньше.
{%- endcomment -%}
<style>
  .evamats-cart-sidebar__checkout[aria-disabled='true'] { cursor: not-allowed; }
  .evamats-cart-sidebar__actions .message_text {
    display: flex; align-items: flex-start; gap: 8px;
    margin: 6px 0 10px; padding: 10px 12px;
    border: 1px solid #ff2741; border-radius: 10px;
    background: rgba(255, 39, 65, .07);
    color: #d1001f; font-size: 14px; line-height: 1.35; font-weight: 500;
  }
  .evamats-cart-sidebar__actions .message_text.hidden { display: none; }
  .evamats-cart-sidebar__actions .message_text::before { content: '!'; font-weight: 700; }
  .evamats-cart-sidebar__terms.is-missing .checkmark { outline: 2px solid #ff2741; outline-offset: 2px; }
</style>
<script>
  (function () {
    function init(root) {
      var cb  = root.querySelector('[data-cart-terms-checkbox]');
      var btn = root.querySelector('#checkout');
      var msg = root.querySelector('.message_text');
      var lbl = root.querySelector('.evamats-cart-sidebar__terms');
      if (!cb || !btn || btn.dataset.termsGuard === '1') return;
      btn.dataset.termsGuard = '1';
      btn.disabled = false;
      function sync() {
        btn.setAttribute('aria-disabled', cb.checked ? 'false' : 'true');
        if (cb.checked) {
          if (msg) msg.classList.add('hidden');
          if (lbl) lbl.classList.remove('is-missing');
        }
      }
      cb.addEventListener('change', sync);
      btn.addEventListener('click', function (e) {
        if (cb.checked) return;
        e.preventDefault();
        e.stopPropagation();
        if (msg) msg.classList.remove('hidden');
        if (lbl) lbl.classList.add('is-missing');
        cb.focus();
      }, true);
      sync();
    }
    function scan() { document.querySelectorAll('.evamats-cart-sidebar').forEach(init); }
    document.addEventListener('DOMContentLoaded', scan);
    document.addEventListener('cart:refresh', scan);
    scan();
  })();
</script>
