{%- comment -%}
  Drawer dock — car CTA (Figma / mobile nav concept).
  @param section {section}
{%- endcomment -%}

{%- liquid
  assign car_label = section.settings.drawer_car_cta_label
  assign car_hint = section.settings.drawer_car_cta_hint
  assign car_url = section.settings.drawer_car_cta_url
-%}

{%- if car_label != blank and car_url != blank -%}
  <div class="evamats-header-drawer__dock">
    <a href="{{ car_url }}" class="evamats-header-drawer__car-cta">
      <span class="evamats-header-drawer__car-cta-icon" aria-hidden="true">
        <img
          src="{{ 'car_button.webp' | asset_url }}"
          class="evamats-header-drawer__car-cta-img"
          width="58"
          height="58"
          loading="lazy"
          alt=""
        >
      </span>
      <span class="evamats-header-drawer__car-cta-copy">
        <span class="evamats-header-drawer__car-cta-label">{{ car_label | escape }}</span>
        {%- if car_hint != blank -%}
          <span class="evamats-header-drawer__car-cta-hint">{{ car_hint | escape }}</span>
        {%- endif -%}
      </span>
      <svg class="evamats-header-drawer__car-cta-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
{%- endif -%}
