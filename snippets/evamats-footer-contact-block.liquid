{%- comment -%}
  Footer contact block — structured rows with hardcoded icons.
  @param block {block}
{%- endcomment -%}

{%- liquid
  assign contact_email = block.settings.email | strip
  assign contact_phone = block.settings.phone | strip
  assign contact_address = block.settings.address | strip
  assign phone_href = contact_phone | replace: ' ', '' | replace: '-', ''
  case localization.language.iso_code
    when 'cs'
      assign lbl_email = 'E-mail:'
      assign lbl_phone = 'Telefon:'
      assign lbl_addr  = 'Adresa:'
    when 'de'
      assign lbl_email = 'E-Mail:'
      assign lbl_phone = 'Telefon:'
      assign lbl_addr  = 'Adresse:'
    when 'lv'
      assign lbl_email = 'E-pasts:'
      assign lbl_phone = 'Tālrunis:'
      assign lbl_addr  = 'Adrese:'
    else
      assign lbl_email = 'Email:'
      assign lbl_phone = 'Phone:'
      assign lbl_addr  = 'Address:'
  endcase
-%}

<div class="evamats-footer__contact" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <p class="evamats-footer__menu-heading">{{ block.settings.heading | escape }}</p>
  {%- endif -%}

  {%- if block.settings.intro != blank or contact_email != blank or contact_phone != blank or contact_address != blank -%}
    <div class="evamats-footer__contact-body rte">
      {%- if block.settings.intro != blank -%}
        <div class="evamats-footer__contact-intro rte">{{ block.settings.intro }}</div>
      {%- endif -%}
      {%- if contact_email != blank -%}
        <p class="evamats-footer__contact-line">✉️ <strong>{{ lbl_email }}</strong> <a href="mailto:{{ contact_email | escape }}">{{- contact_email | escape -}}</a></p>
      {%- endif -%}
      {%- if localization.language.iso_code == 'cs' and contact_phone != blank -%}
        <p class="evamats-footer__contact-line">📞 <strong>{{ lbl_phone }}</strong> <a href="tel:{{ phone_href | escape }}">{{- contact_phone | escape -}}</a></p>
      {%- endif -%}
      {%- if localization.language.iso_code == 'cs' and contact_address != blank -%}
        {%- assign addr_parts = contact_address | strip | split: '
' -%}
        <p class="evamats-footer__contact-line">📍 <strong>{{ lbl_addr }}</strong><br>{{ addr_parts[0] | strip }}{%- if addr_parts.size > 1 -%}<br><span class="evamats-footer__contact-note">{%- for part in addr_parts offset: 1 -%}{{ part | strip }}{%- unless forloop.last -%}<br>{%- endunless -%}{%- endfor -%}</span>{%- endif -%}</p>
      {%- endif -%}
  {%- endif -%}
</div>

