{%- comment -%}
  EvaMats product gallery viewer controls — Figma 2109:13380 mobile / 2106:13355 desktop.

  Accepts:
  - media_count: {Number}
  - hide_mobile_slider: {Boolean} Dawn flag; overridden in CSS for .evamats-product-gallery
{%- endcomment -%}

<div class="slider-buttons no-js-hidden quick-add-hidden{% if hide_mobile_slider %} small-hide{% endif %}">
  <button
    type="button"
    class="slider-button slider-button--prev evamats-product-gallery__arrow"
    name="previous"
    aria-label="{{ 'general.slider.previous_slide' | t }}"
  >
    {% render 'evamats-slider-arrow', direction: 'prev' %}
  </button>
  {%- if media_count > 1 -%}
    <div
      class="slider-counter slider-counter--counter evamats-product-gallery__dots evamats-product-gallery__counter caption"
      data-gallery-counter
      aria-live="polite"
    >
      <span class="evamats-product-gallery__counter-current" data-gallery-counter-current>1</span>
      <span class="evamats-product-gallery__counter-sep" aria-hidden="true">/</span>
      <span class="evamats-product-gallery__counter-total" data-gallery-counter-total>{{ media_count }}</span>
    </div>
  {%- endif -%}
  <button
    type="button"
    class="slider-button slider-button--next evamats-product-gallery__arrow"
    name="next"
    aria-label="{{ 'general.slider.next_slide' | t }}"
  >
    {% render 'evamats-slider-arrow', direction: 'next' %}
  </button>
</div>
