{%- assign review_text = 'carvion_cro.reviews.r1' | t -%}
<article class="cz-cro-review-card" aria-label="Maggie Newton">
  <img src="{{ 'image_-_2025-09-09T162623.807.webp' | file_url }}&width=640" width="640" height="420" loading="lazy" alt="{{ 'carvion_cro.photo_alt' | t: name: 'Maggie Newton' | escape }}">
  <div class="cz-cro-review-content">
    <div class="cz-cro-review-byline"><div class="cz-cro-review-author"><img class="cz-cro-review-avatar" src="{{ 'unnamed_1.png' | file_url }}" width="36" height="36" loading="lazy" alt=""><div><strong>Maggie Newton</strong><span class="cz-cro-stars" aria-label="{{ 'carvion_cro.rating' | t: rating: 5 | escape }}">★★★★★</span></div></div></div>
    <blockquote>
      <p class="cz-cro-review-excerpt">{{ review_text | truncatewords: 34 | escape }}</p>
      {%- assign review_words = review_text | split: ' ' -%}
      {%- if review_words.size > 34 -%}
        <details class="cz-cro-review-details">
          <summary><span class="cz-cro-read-more">{{ 'carvion_cro.read_more' | t }}</span><span class="cz-cro-read-less">{{ 'carvion_cro.read_less' | t }}</span></summary>
          <p>{{ review_text | escape | newline_to_br }}</p>
        </details>
      {%- endif -%}
    </blockquote>
    <p class="cz-cro-review-source">{{ 'carvion_cro.source' | t }}</p>
  </div>
</article>
