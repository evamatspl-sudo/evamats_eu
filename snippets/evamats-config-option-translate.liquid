{% comment %}
  Localises visible configurator option names and values without changing the
  underlying Shopify option value used by variants, images and cart logic.
  Params: text
{% endcomment %}
{%- liquid
  assign source = text | default: '' | split: '#MWS' | first | strip
  assign localised = source
  if request.locale.iso_code == 'fr'
    assign normalised = source | downcase | strip | replace: '  ', ' '
    case normalised
      when 'card type'
        assign localised = 'Type de carte'
      when 'e-card'
        assign localised = 'Carte électronique'
      when 'paper (+5€)', 'paper (+5 €)'
        assign localised = 'Carte papier (+5 €)'
      when 'mats type'
        assign localised = 'Type de tapis'
      when 'mats set'
        assign localised = 'Ensemble de tapis'
      when 'size'
        assign localised = 'Dimensions'
      when 'title'
        assign localised = 'Titre'
      when 'mount'
        assign localised = 'Montage'
      when '3d carvion without edges'
        assign localised = '3D CARVION sans rebords relevés'
      when '3d carvion with edges'
        assign localised = '3D CARVION avec rebords relevés'
      when 'only driver mat'
        assign localised = 'Tapis conducteur'
      when 'front'
        assign localised = 'Avant'
      when 'rear'
        assign localised = 'Arrière'
      when 'trunk'
        assign localised = 'Tapis de coffre'
      when 'front + rear', 'front+rear'
        assign localised = 'Avant + arrière'
      when 'front + rear + trunk', 'front + rear + boot'
        assign localised = 'Avant + arrière + tapis de coffre'
      when '1 row'
        assign localised = '1 rangée'
      when '2 rows'
        assign localised = '2 rangées'
      when '3 rows'
        assign localised = '3 rangées'
      when 'front + rear + third row'
        assign localised = 'Avant + arrière + troisième rangée'
      when 'front + rear + third row + small trunk'
        assign localised = 'Avant + arrière + troisième rangée + petit tapis de coffre'
      when 'front + rear + third row + huge trunk', 'front + rear + third row + large trunk'
        assign localised = 'Avant + arrière + troisième rangée + grand tapis de coffre'
      when 'front + trunk'
        assign localised = 'Avant + tapis de coffre'
      when '3 rows + huge trunk', '3 rows + large trunk'
        assign localised = '3 rangées + grand tapis de coffre'
      when 'huge trunk', 'large trunk'
        assign localised = 'Grand tapis de coffre'
      when '3 rows + 2 trunks(small|huge)', '3 rows + 2 trunks (small|huge)', '3 rows + 2 trunks (huge | small)'
        assign localised = '3 rangées + 2 tapis de coffre (petit et grand)'
      when '3 rows + small trunk'
        assign localised = '3 rangées + petit tapis de coffre'
      when 'small trunk'
        assign localised = 'Petit tapis de coffre'
      when '1 row + trunk'
        assign localised = '1 rangée + tapis de coffre'
      when '2 rows + trunk'
        assign localised = '2 rangées + tapis de coffre'
      when 'front with tunnel'
        assign localised = 'Avant avec tapis de tunnel'
      when 'front without tunnel'
        assign localised = 'Avant sans tapis de tunnel'
      when 'front + rear + 3 trunks (front trunk + 2 rear trunks)'
        assign localised = 'Avant + arrière + 3 tapis de coffre (1 avant + 2 arrière)'
      when 'front + rear + 3 row + huge trunk (front | 2 rear)'
        assign localised = 'Avant + arrière + troisième rangée + grand tapis de coffre (1 avant + 2 arrière)'
      when 'front + rear + 3 row + small trunk (front | 2 rear)'
        assign localised = 'Avant + arrière + troisième rangée + petit tapis de coffre (1 avant + 2 arrière)'
      when 'front + rear + trunk (front | 2 rear)'
        assign localised = 'Avant + arrière + tapis de coffre (1 avant + 2 arrière)'
      when 'mounted (+2€)', 'mounted (+2 €)'
        assign localised = 'Avec montage (+2 €)'
      when 'unmounted'
        assign localised = 'Sans montage'
      when 'default title'
        assign localised = 'Titre par défaut'
    endcase
  endif
-%}
{{- localised -}}
