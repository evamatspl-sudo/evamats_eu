{%- liquid
  assign catalog_menu = section.settings.catalog_menu
  assign nav_menu = section.settings.mobile_menu
  if nav_menu == blank
    assign nav_menu = section.settings.menu
  endif
  assign view_all_label = section.settings.catalog_view_all_label
  assign catalog_label = section.settings.drawer_catalog_label
  assign more_label = section.settings.drawer_more_label
  assign custom_meta = section.settings.drawer_custom_meta
  assign phone_1 = section.settings.drawer_phone_1
  assign drawer_email = section.settings.drawer_email

  assign localization_return_to = request.path
  if request.query_string != blank
    assign localization_return_to = localization_return_to | append: '?' | append: request.query_string
  endif

  assign show_lang = false
  if section.settings.enable_language_selector and localization.available_languages.size > 1
    assign show_lang = true
  endif

  assign show_utility = false
  if show_lang or phone_1 != blank or drawer_email != blank
    assign show_utility = true
  endif
-%}

<div
  id="EvamatsHeaderDrawer-{{ section.id }}"
  class="evamats-header-drawer"
  aria-hidden="true"
  data-evamats-header-drawer
>
  <div class="evamats-header-drawer__overlay" data-evamats-drawer-close tabindex="-1"></div>

  <div class="evamats-header-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
    {%- if section.settings.drawer_background_image != blank -%}
      <div class="evamats-header-drawer__bg" aria-hidden="true">
        {{
          section.settings.drawer_background_image
          | image_url: width: 750
          | image_tag: class: 'evamats-header-drawer__bg-img', loading: 'lazy', alt: ''
        }}
      </div>
    {%- endif -%}

    <div class="evamats-header-drawer__views">
      <div class="evamats-header-drawer__view evamats-header-drawer__view--main" data-drawer-view="main">
        <div class="evamats-header-drawer__top">
          <a href="{{ routes.root_url }}" class="evamats-header-drawer__logo-link">
            {%- if settings.logo != blank -%}
              {{
                settings.logo
                | image_url: width: 296
                | image_tag: class: 'evamats-header-drawer__logo', widths: '148, 296', sizes: '148px', alt: settings.logo.alt | default: shop.name
              }}
            {%- else -%}
              <span class="evamats-header__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </a>

          <button type="button" class="evamats-header-drawer__close" aria-label="{{ 'accessibility.close' | t }}" data-evamats-drawer-close>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <div class="evamats-header-drawer__scroll">
          {%- if catalog_menu != blank and catalog_menu.links.size > 0 -%}
            <div class="evamats-header-drawer__catalog">
              {%- if catalog_label != blank -%}
                <p class="evamats-header-drawer__section-label">{{ catalog_label | escape }}</p>
              {%- endif -%}
              {%- for link in catalog_menu.links -%}
                {%- capture menu_item_handle -%}{%- render 'evamats-menu-link-handle', link: link -%}{%- endcapture -%}
                {%- if link.links != blank -%}
                  <button
                    type="button"
                    class="evamats-header-drawer__catalog-item evamats-header-drawer__catalog-item--trigger"
                    data-drawer-open-sub="catalog-l1-{{ forloop.index }}"
                  >
                    {% render 'evamats-header-catalog-l1-icon', section: section, menu_item_handle: menu_item_handle %}
                    <span class="evamats-header-drawer__catalog-label">{{ link.title | escape }}</span>
                    <svg class="evamats-header-drawer__row-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {%- else -%}
                  <a href="{{ link.url }}" class="evamats-header-drawer__catalog-item">
                    {% render 'evamats-header-catalog-l1-icon', section: section, menu_item_handle: menu_item_handle %}
                    <span class="evamats-header-drawer__catalog-label">{{ link.title | escape }}</span>
                    <svg class="evamats-header-drawer__row-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
            <hr class="evamats-header-drawer__divider" aria-hidden="true">
            <nav class="evamats-header-drawer__nav" aria-label="Navigation">
              {%- assign more_links_started = false -%}
              {%- for link in nav_menu.links -%}
                {%- capture menu_item_handle -%}{%- render 'evamats-menu-link-handle', link: link -%}{%- endcapture -%}
                {%- assign menu_item_handle = menu_item_handle | strip | downcase -%}

                {%- if link.links != blank -%}
                  {%- if more_links_started -%}
                    </div>
                    {%- assign more_links_started = false -%}
                  {%- endif -%}

                  {%- capture group_meta -%}
                    {%- if custom_meta != blank -%}
                      {{- custom_meta -}}
                    {%- else -%}
                      {%- for childlink in link.links -%}
                        {{- childlink.title -}}
                        {%- unless forloop.last %} · {% endunless -%}
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endcapture -%}

                  <div class="evamats-header-drawer__nav-group">
                    <button
                      type="button"
                      class="evamats-header-drawer__nav-row"
                      data-drawer-accordion
                      aria-expanded="false"
                      aria-controls="DrawerNavGroup-{{ section.id }}-{{ forloop.index }}"
                    >
                      <span class="evamats-header-drawer__nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M4 20L20 4M7.5 20.5l-3-3L18.5 3.5l3 3L7.5 20.5z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M8 14l2 2M12 10l2 2M16 6l2 2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                        </svg>
                      </span>
                      <span class="evamats-header-drawer__nav-label">
                        {{ link.title | escape }}
                        {%- if group_meta != blank -%}
                          <span class="evamats-header-drawer__nav-meta">{{ group_meta | strip | escape }}</span>
                        {%- endif -%}
                      </span>
                      <svg class="evamats-header-drawer__row-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div
                      class="evamats-header-drawer__nav-accordion"
                      id="DrawerNavGroup-{{ section.id }}-{{ forloop.index }}"
                    >
                      <div class="evamats-header-drawer__nav-accordion-inner">
                        {%- for childlink in link.links -%}
                          <a href="{{ childlink.url }}" class="evamats-header-drawer__nav-sublink">{{ childlink.title | escape }}</a>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>

                {%- elsif menu_item_handle == 'outlet' -%}
                  {%- if more_links_started -%}
                    </div>
                    {%- assign more_links_started = false -%}
                  {%- endif -%}
                  <a href="{{ link.url }}" class="evamats-header-drawer__nav-row evamats-header-drawer__nav-row--accent">
                    <span class="evamats-header-drawer__nav-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" stroke="currentColor" stroke-width="1.75"/>
                        <path d="M15 9L9 15M9.5 9.5h.01M14.5 14.5h.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="evamats-header-drawer__nav-label">{{ link.title | escape }}</span>
                    <svg class="evamats-header-drawer__row-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>

                {%- elsif more_label != blank -%}
                  {%- unless more_links_started -%}
                    {%- assign more_links_started = true -%}
                    <div class="evamats-header-drawer__nav-group">
                      <button
                        type="button"
                        class="evamats-header-drawer__nav-row"
                        data-drawer-accordion
                        aria-expanded="false"
                        aria-controls="DrawerNavMore-{{ section.id }}"
                      >
                        <span class="evamats-header-drawer__nav-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"/>
                            <path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                        <span class="evamats-header-drawer__nav-label">{{ more_label | escape }}</span>
                        <svg class="evamats-header-drawer__row-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                          <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                      <div class="evamats-header-drawer__nav-accordion" id="DrawerNavMore-{{ section.id }}">
                        <div class="evamats-header-drawer__nav-accordion-inner">
                  {%- endunless -%}
                  <a href="{{ link.url }}" class="evamats-header-drawer__nav-sublink">{{ link.title | escape }}</a>

                {%- else -%}
                  <a href="{{ link.url }}" class="evamats-header-drawer__nav-row">
                    <span class="evamats-header-drawer__nav-label">{{ link.title | escape }}</span>
                    <svg class="evamats-header-drawer__row-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                {%- endif -%}
              {%- endfor -%}
              {%- if more_links_started -%}
                        </div>
                      </div>
                    </div>
              {%- endif -%}
            </nav>
          {%- endif -%}
        </div>

        {%- if show_utility -%}
          <div class="evamats-header-drawer__utility">
            {%- if show_lang -%}
              <div class="evamats-header-drawer__lang">
                <localization-form>
                  {%- form 'localization', id: 'DrawerLanguageForm', class: 'localization-form', return_to: localization_return_to -%}
                    <div class="no-js-hidden">
                      <div class="disclosure">
                        <button
                          type="button"
                          class="evamats-header-drawer__utility-btn evamats-header-drawer__utility-btn--lang localization-form__select localization-selector"
                          aria-expanded="false"
                          aria-controls="DrawerLanguageList"
                        >
                          <svg class="evamats-header-drawer__utility-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
                            <path d="M3 12h18M12 3c2.5 2.6 3.8 5.8 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.8-3.8-9S9.5 5.6 12 3z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                          <span class="evamats-header-drawer__lang-current">{{ localization.language.endonym_name | capitalize }} ({{ localization.language.iso_code | upcase }})</span>
                          <svg class="evamats-header-drawer__lang-chevron" width="12" height="12" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                            <path d="M1.5 3.5L5 7L8.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                        <div class="disclosure__list-wrapper" hidden>
                          <ul id="DrawerLanguageList" role="list" class="evamats-header-drawer__lang-list list-unstyled">
                            {%- for language in localization.available_languages -%}
                              <li class="evamats-header-drawer__lang-item">
                                <a
                                  class="evamats-header-drawer__lang-link{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"
                                  href="#"
                                  hreflang="{{ language.iso_code }}"
                                  lang="{{ language.iso_code }}"
                                  {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
                                  data-value="{{ language.iso_code }}"
                                >
                                  {{ language.endonym_name | capitalize }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                      <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
                    </div>
                  {%- endform -%}
                </localization-form>
              </div>
            {%- endif -%}

            {%- if phone_1 != blank -%}
              <a
                href="tel:{{ phone_1 | replace: ' ', '' | replace: '-', '' }}"
                class="evamats-header-drawer__utility-btn"
                aria-label="{{ phone_1 | escape }}"
                title="{{ phone_1 | escape }}"
              >
                <svg class="evamats-header-drawer__utility-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}

            {%- if drawer_email != blank -%}
              <a
                href="mailto:{{ drawer_email | escape }}"
                class="evamats-header-drawer__utility-btn"
                aria-label="{{ drawer_email | escape }}"
                title="{{ drawer_email | escape }}"
              >
                <svg class="evamats-header-drawer__utility-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M22 8L12 13 2 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {% render 'evamats-header-drawer-footer', section: section %}
      </div>

      {%- if catalog_menu != blank -%}
        {%- for link in catalog_menu.links -%}
          {%- if link.links != blank -%}
            {%- capture catalog_parent_handle -%}{%- render 'evamats-menu-link-handle', link: link -%}{%- endcapture -%}
            <div
              class="evamats-header-drawer__view evamats-header-drawer__view--sub"
              data-drawer-view="catalog-l1-{{ forloop.index }}"
              hidden
            >
              <div class="evamats-header-drawer__sub-top">
                <button type="button" class="evamats-header-drawer__sub-back" data-drawer-back aria-label="{{ 'accessibility.back' | t }}">
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M12 4L6 10L12 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <p class="evamats-header-drawer__sub-title">{{ link.title | escape }}</p>
                <button type="button" class="evamats-header-drawer__close" aria-label="{{ 'accessibility.close' | t }}" data-evamats-drawer-close>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>

              <div class="evamats-header-drawer__sub-scroll">
                <ul class="evamats-header-drawer__sub-grid" role="list">
                  {%- for childlink in link.links -%}
                    {%- capture menu_item_handle -%}{%- render 'evamats-menu-link-handle', link: childlink -%}{%- endcapture -%}
                    <li class="evamats-header-drawer__sub-grid-item">
                      {%- if childlink.links != blank -%}
                        <button
                          type="button"
                          class="evamats-header-drawer__sub-card"
                          data-drawer-open-sub="catalog-l2-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                        >
                          <span class="evamats-header-drawer__sub-card-media">
                            {% render 'evamats-header-catalog-icon', section: section, menu_item_handle: menu_item_handle %}
                          </span>
                          <span class="evamats-header-drawer__sub-card-foot"><span class="evamats-header-drawer__sub-card-label">{{ childlink.title | escape }}</span><svg class="evamats-header-drawer__sub-card-chev" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                        </button>
                      {%- else -%}
                        <a href="{{ childlink.url }}" class="evamats-header-drawer__sub-card">
                          <span class="evamats-header-drawer__sub-card-media">
                            {% render 'evamats-header-catalog-icon', section: section, menu_item_handle: menu_item_handle %}
                          </span>
                          <span class="evamats-header-drawer__sub-card-foot"><span class="evamats-header-drawer__sub-card-label">{{ childlink.title | escape }}</span></span>
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}

                  {%- if catalog_parent_handle == 'car-brands' -%}
                    <li class="evamats-header-drawer__sub-grid-item">
                      <a href="{{ routes.root_url }}pages/rubber-car-mats" class="evamats-header-drawer__sub-card">
                        <span class="evamats-header-drawer__sub-card-media">
                          <img
                            src="{{ 'evamats-rubber-mats-mobile-sidebar.webp' | asset_url }}"
                            class="evamats-header-drawer__catalog-icon"
                            width="1000"
                            height="750"
                            loading="lazy"
                            decoding="async"
                            alt=""
                          >
                        </span>
                        <span class="evamats-header-drawer__sub-card-foot"><span class="evamats-header-drawer__sub-card-label">Gumové autokoberce</span></span>
                      </a>
                    </li>
                    <li class="evamats-header-drawer__sub-grid-item">
                      <a href="{{ routes.root_url }}pages/velour-car-mats" class="evamats-header-drawer__sub-card">
                        <span class="evamats-header-drawer__sub-card-media">
                          <img
                            src="{{ 'evamats-velour-mats-mobile-sidebar.webp' | asset_url }}"
                            class="evamats-header-drawer__catalog-icon"
                            width="1000"
                            height="750"
                            loading="lazy"
                            decoding="async"
                            alt=""
                          >
                        </span>
                        <span class="evamats-header-drawer__sub-card-foot"><span class="evamats-header-drawer__sub-card-label">Velurové autokoberce</span></span>
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              </div>

              {%- if link.url != blank and view_all_label != blank -%}
                <div class="evamats-header-drawer__sub-footer">
                  <a href="{{ link.url }}" class="evamats-header-drawer__sub-cta">{{ view_all_label | escape }}</a>
                </div>
              {%- endif -%}
            </div>

            {%- for childlink in link.links -%}
              {%- if childlink.links != blank -%}
                <div
                  class="evamats-header-drawer__view evamats-header-drawer__view--sub"
                  data-drawer-view="catalog-l2-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                  hidden
                >
                  <div class="evamats-header-drawer__sub-top">
                    <button type="button" class="evamats-header-drawer__sub-back" data-drawer-back aria-label="{{ 'accessibility.back' | t }}">
                      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M12 4L6 10L12 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <p class="evamats-header-drawer__sub-title">{{ childlink.title | escape }}</p>
                    <button type="button" class="evamats-header-drawer__close" aria-label="{{ 'accessibility.close' | t }}" data-evamats-drawer-close>
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>

                  <div class="evamats-header-drawer__sub-scroll">
                    <ul class="evamats-header-drawer__sub-list" role="list">
                      {%- for grandchildlink in childlink.links -%}
                        <li>
                          <a href="{{ grandchildlink.url }}" class="evamats-header-drawer__sub-list-link">{{ grandchildlink.title | escape }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>

                  {%- if childlink.url != blank and view_all_label != blank -%}
                    <div class="evamats-header-drawer__sub-footer">
                      <a href="{{ childlink.url }}" class="evamats-header-drawer__sub-cta">{{ view_all_label | escape }}</a>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>
