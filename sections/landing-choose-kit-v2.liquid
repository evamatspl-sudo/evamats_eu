{{ 'section-landing-choose-kit-v2.css' | asset_url | stylesheet_tag }}

<div
  id="LandingChooseKit-{{ section.id }}"
  class="landing-choose-kit-v2"
  style="
    --lck-bg: {{ section.settings.background_color }};
    --lck-padding-top: {{ section.settings.padding_top }}px;
    --lck-padding-bottom: {{ section.settings.padding_bottom }}px;
    --lck-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --lck-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="landing-choose-kit-v2__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="landing-choose-kit-v2__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- assign step_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'step' -%}
        {%- assign step_count = step_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if step_count > 0 -%}
      <div class="landing-choose-kit-v2__steps" role="list">
        {%- assign step_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_index = step_index | plus: 1 -%}
            {%- liquid
              assign step_label = block.settings.label
              assign step_label_mobile = block.settings.label_mobile
              if step_label_mobile == blank
                assign step_label_mobile = step_label
              endif
            -%}
            {%- if step_index > 1 -%}
              <span class="landing-choose-kit-v2__arrow" aria-hidden="true">→</span>
            {%- endif -%}
            <div class="landing-choose-kit-v2__step" role="listitem" {{ block.shopify_attributes }}>
              <span class="landing-choose-kit-v2__step-num">{{ step_index }}</span>
              {%- if step_label != blank -%}
                <span class="landing-choose-kit-v2__step-label landing-choose-kit-v2__step-label--desktop">
                  {{- step_label | escape -}}
                </span>
                <span class="landing-choose-kit-v2__step-label landing-choose-kit-v2__step-label--mobile">
                  {{- step_label_mobile | escape -}}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign offer_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'offer' -%}
        {%- assign offer_count = offer_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if offer_count > 0 -%}
      <div class="landing-choose-kit-v2__offers">
        {%- for block in section.blocks -%}
          {%- if block.type == 'offer' -%}
            <article class="landing-choose-kit-v2__offer" {{ block.shopify_attributes }}>
              <div class="landing-choose-kit-v2__offer-top">
                <div class="landing-choose-kit-v2__offer-copy">
                  {%- if block.settings.title != blank -%}
                    <h3 class="landing-choose-kit-v2__offer-title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <p class="landing-choose-kit-v2__offer-subtitle">{{ block.settings.subtitle | escape }}</p>
                  {%- endif -%}
                </div>
                {%- if block.settings.price != blank -%}
                  <p class="landing-choose-kit-v2__offer-price">{{ block.settings.price | escape }}</p>
                {%- endif -%}
              </div>

              {%- if block.settings.button_label != blank -%}
                {%- if block.settings.button_link != blank -%}
                  <a class="landing-choose-kit-v2__offer-btn" href="{{ block.settings.button_link }}">
                    {{- block.settings.button_label | escape -}}
                  </a>
                {%- else -%}
                  <span class="landing-choose-kit-v2__offer-btn">{{ block.settings.button_label | escape }}</span>
                {%- endif -%}
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note_1 != blank
      or section.settings.note_2 != blank
      or section.settings.note_3 != blank
      or section.settings.contact_email != blank
    -%}
      <div class="landing-choose-kit-v2__notes">
        {%- if section.settings.note_1 != blank -%}
          <p class="landing-choose-kit-v2__note">{{ section.settings.note_1 | escape | newline_to_br }}</p>
        {%- endif -%}

        {%- if section.settings.note_2 != blank or section.settings.contact_email != blank -%}
          <p class="landing-choose-kit-v2__note">
            {%- if section.settings.note_2 != blank -%}
              {{- section.settings.note_2 | escape -}}
            {%- endif -%}
            {%- if section.settings.contact_email != blank -%}
              {%- if section.settings.note_2 != blank -%}
                {{- ' ' -}}
              {%- endif -%}
              <a class="landing-choose-kit-v2__email" href="mailto:{{ section.settings.contact_email | escape }}">
                {{- section.settings.contact_email | escape -}}
              </a>.
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if section.settings.note_3 != blank -%}
          <p class="landing-choose-kit-v2__note">{{ section.settings.note_3 | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank or section.settings.trust_text != blank -%}
      <div class="landing-choose-kit-v2__cta-wrap">
        {%- if section.settings.cta_label != blank -%}
          {%- if section.settings.cta_link != blank -%}
            <a class="landing-choose-kit-v2__cta" href="{{ section.settings.cta_link }}">
              {{- section.settings.cta_label | escape -}}
            </a>
          {%- else -%}
            <span class="landing-choose-kit-v2__cta">{{ section.settings.cta_label | escape }}</span>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.trust_text != blank -%}
          <p class="landing-choose-kit-v2__trust">{{ section.settings.trust_text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

