{{ 'section-landing-antagonist-v2.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign card_count = 0
  for block in section.blocks
    if block.type == 'card'
      assign card_count = card_count | plus: 1
    endif
  endfor

  assign card_text_style = section.settings.card_text_style | default: 'left'
  assign section_class = 'landing-antagonist-v2'
  if card_text_style == 'center_bold'
    assign section_class = section_class | append: ' landing-antagonist-v2--card-center-bold'
  endif
-%}

<div
  id="LandingAntagonist-{{ section.id }}"
  class="{{ section_class }}"
  style="
    --la-bg: {{ section.settings.background_color }};
    --la-padding-top: {{ section.settings.padding_top }}px;
    --la-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="landing-antagonist-v2__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="landing-antagonist-v2__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="landing-antagonist-v2__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="landing-antagonist-v2__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if card_count > 0 -%}
      <div class="landing-antagonist-v2__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <article class="landing-antagonist-v2__card" {{ block.shopify_attributes }}>
              <div class="landing-antagonist-v2__card-media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'landing-antagonist-v2__card-image',
                      widths: '400, 600, 800, 1200',
                      sizes: '(max-width: 749px) 100vw, 33vw'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'landing-antagonist-v2__card-image landing-antagonist-v2__placeholder' }}
                {%- endif -%}
              </div>

              {%- if block.settings.text != blank -%}
                <p class="landing-antagonist-v2__card-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Landing antagonist v2",
  "tag": "section",
  "class": "section_v2 section-landing-antagonist-v2",
  "max_blocks": 6,
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Twój dywanik fabryczny został zaprojektowany pod minimalny standard — nie pod Twoje auto"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Antagonistą nie jest konkretna marka, a cała kategoria uniwersalnych produktów: fabryczne i tanie zamienniki zakrywają tylko część podłogi, zostawiają odsłonięty tunel środkowy, a welur wchłania wodę i traci wygląd już po jednym sezonie."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f6f6f6"
    },
    {
      "type": "select",
      "id": "card_text_style",
      "label": "Card text style",
      "options": [
        {
          "value": "left",
          "label": "Left regular"
        },
        {
          "value": "center_bold",
          "label": "Center bold"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 98
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 168
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Tanie zamienniki są cięte z jednego szablonu — niezależnie od modelu Twojego auta"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing antagonist v2",
      "category": "V2",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "text": "Tanie zamienniki są cięte z jednego szablonu — niezależnie od modelu Twojego auta"
          }
        },
        {
          "type": "card",
          "settings": {
            "text": "Uniwersalny dywanik nie zakrywa całej podłogi — zostają odsłonięte krawędzie i tunel środkowy"
          }
        },
        {
          "type": "card",
          "settings": {
            "text": "Welur wchłania wodę i błoto, traci wygląd już po jednym sezonie"
          }
        }
      ]
    }
  ]
}
{% endschema %}
