{{ 'section-landing-compare-v2.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign col_1 = section.settings.col_1_label | default: 'EVA'
  assign col_2 = section.settings.col_2_label | default: 'Guma'
  assign col_3 = section.settings.col_3_label | default: 'Welur'
  assign highlight_col = section.settings.highlight_column | default: '1'
  assign layout_mode = section.settings.layout | default: 'table'

  assign row_count = 0
  for block in section.blocks
    if block.type == 'row'
      assign row_count = row_count | plus: 1
    endif
  endfor
-%}

<div
  id="LandingCompare-{{ section.id }}"
  class="landing-compare-v2{% if layout_mode == 'cards' %} landing-compare-v2--cards{% endif %}"
  style="
    --lcm-padding-top: {{ section.settings.padding_top }}px;
    --lcm-padding-bottom: {{ section.settings.padding_bottom }}px;
    --lcm-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --lcm-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="landing-compare-v2__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="landing-compare-v2__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="landing-compare-v2__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="landing-compare-v2__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if row_count > 0 and layout_mode == 'cards' -%}
      <div class="landing-compare-v2__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
            {%- liquid
              assign card_icon = block.settings.icon | default: 'coverage'
              assign card_icon_file = 'landing-compare-icon-coverage.svg'
              if card_icon == 'smell'
                assign card_icon_file = 'landing-compare-icon-smell.svg'
              elsif card_icon == 'cleaning'
                assign card_icon_file = 'landing-compare-icon-cleaning.svg'
              elsif card_icon == 'durability'
                assign card_icon_file = 'landing-compare-icon-durability.svg'
              elsif card_icon == 'fit'
                assign card_icon_file = 'landing-compare-icon-fit.svg'
              endif
            -%}
            <article class="landing-compare-v2__card" {{ block.shopify_attributes }}>
              <div class="landing-compare-v2__card-icon">
                <img
                  src="{{ card_icon_file | asset_url }}"
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                >
              </div>
              {%- if block.settings.label != blank -%}
                <h3 class="landing-compare-v2__card-title">{{ block.settings.label | escape }}</h3>
              {%- endif -%}
              <div class="landing-compare-v2__card-rule" aria-hidden="true"></div>
              {%- for col_i in (1..3) -%}
                {%- liquid
                  if col_i == 1
                    assign col_label = col_1
                    assign col_value = block.settings.value_1
                  elsif col_i == 2
                    assign col_label = col_2
                    assign col_value = block.settings.value_2
                  else
                    assign col_label = col_3
                    assign col_value = block.settings.value_3
                  endif
                  assign col_i_str = col_i | append: ''
                  assign is_highlight = false
                  if highlight_col == col_i_str
                    assign is_highlight = true
                  endif
                -%}
                {%- if col_value != blank -%}
                  <div class="landing-compare-v2__fact{% if is_highlight %} landing-compare-v2__fact--win{% else %} landing-compare-v2__fact--lose{% endif %}">
                    <div class="landing-compare-v2__fact-head">
                      {%- if is_highlight -%}
                        <img
                          class="landing-compare-v2__fact-mark"
                          src="{{ 'landing-compare-check.svg' | asset_url }}"
                          alt=""
                          width="15"
                          height="15"
                          loading="lazy"
                        >
                      {%- else -%}
                        <img
                          class="landing-compare-v2__fact-mark landing-compare-v2__fact-mark--cross"
                          src="{{ 'landing-compare-cross.svg' | asset_url }}"
                          alt=""
                          width="12"
                          height="12"
                          loading="lazy"
                        >
                      {%- endif -%}
                      <span class="landing-compare-v2__fact-name">{{ col_label | escape }}</span>
                    </div>
                    <p class="landing-compare-v2__fact-value">{{ col_value | escape }}</p>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif row_count > 0 -%}
      <div class="landing-compare-v2__table" role="table" aria-label="{{ section.settings.heading | escape }}">
        <div class="landing-compare-v2__head" role="row">
          <div class="landing-compare-v2__cell landing-compare-v2__cell--label" role="columnheader">
            <span class="visually-hidden">Criterion</span>
          </div>
          <div class="landing-compare-v2__cell landing-compare-v2__cell--col" role="columnheader">
            <span class="landing-compare-v2__col-title">{{ col_1 | escape }}</span>
          </div>
          <div class="landing-compare-v2__cell landing-compare-v2__cell--col" role="columnheader">
            <span class="landing-compare-v2__col-title">{{ col_2 | escape }}</span>
          </div>
          <div class="landing-compare-v2__cell landing-compare-v2__cell--col" role="columnheader">
            <span class="landing-compare-v2__col-title">{{ col_3 | escape }}</span>
          </div>
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
            <div class="landing-compare-v2__row" role="row" {{ block.shopify_attributes }}>
              <div class="landing-compare-v2__cell landing-compare-v2__cell--label" role="rowheader">
                {%- if block.settings.label != blank -%}
                  <span class="landing-compare-v2__row-label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </div>

              {%- for col_i in (1..3) -%}
                {%- liquid
                  if col_i == 1
                    assign col_label = col_1
                    assign col_value = block.settings.value_1
                  elsif col_i == 2
                    assign col_label = col_2
                    assign col_value = block.settings.value_2
                  else
                    assign col_label = col_3
                    assign col_value = block.settings.value_3
                  endif
                  assign col_i_str = col_i | append: ''
                  assign is_highlight = false
                  if highlight_col == col_i_str
                    assign is_highlight = true
                  endif
                -%}
                {%- if is_highlight -%}
                  <div class="landing-compare-v2__cell landing-compare-v2__cell--highlight" role="cell">
                    {%- if col_value != blank -%}
                      <span class="landing-compare-v2__pill">
                        <span class="landing-compare-v2__pill-name">{{ col_label | escape }}</span>
                        <span class="landing-compare-v2__pill-value">{{ col_value | escape }}</span>
                      </span>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <div class="landing-compare-v2__cell landing-compare-v2__cell--muted" role="cell">
                    {%- if col_value != blank -%}
                      <span class="landing-compare-v2__pair">
                        <span class="landing-compare-v2__pair-name">{{ col_label | escape }}</span>
                        <span class="landing-compare-v2__pair-value">{{ col_value | escape }}</span>
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Landing compare v2",
  "tag": "section",
  "class": "section_v2 section-landing-compare-v2",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EVA vs guma vs welur"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "table", "label": "Table" },
        { "value": "cards", "label": "Cards" }
      ],
      "default": "table"
    },
    {
      "type": "text",
      "id": "col_1_label",
      "label": "Column 1",
      "default": "EVA"
    },
    {
      "type": "text",
      "id": "col_2_label",
      "label": "Column 2",
      "default": "Guma"
    },
    {
      "type": "text",
      "id": "col_3_label",
      "label": "Column 3",
      "default": "Welur"
    },
    {
      "type": "select",
      "id": "highlight_column",
      "label": "Highlight column",
      "options": [
        { "value": "1", "label": "Column 1" },
        { "value": "2", "label": "Column 2" },
        { "value": "3", "label": "Column 3" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Personalizacja koloru"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Card icon",
          "options": [
            { "value": "coverage", "label": "Coverage" },
            { "value": "smell", "label": "Smell" },
            { "value": "cleaning", "label": "Cleaning" },
            { "value": "durability", "label": "Durability" },
            { "value": "fit", "label": "Fit" }
          ],
          "default": "coverage"
        },
        {
          "type": "text",
          "id": "value_1",
          "label": "Column 1 value",
          "default": "195 wariantów"
        },
        {
          "type": "text",
          "id": "value_2",
          "label": "Column 2 value",
          "default": "zwykle 1–2 kolory"
        },
        {
          "type": "text",
          "id": "value_3",
          "label": "Column 3 value",
          "default": "ograniczona"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing compare v2",
      "category": "V2",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Personalizacja koloru",
            "value_1": "195 wariantów",
            "value_2": "zwykle 1–2 kolory",
            "value_3": "ograniczona"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Wygląd po roku",
            "value_1": "bez zmian",
            "value_2": "matowieje, twardnieje",
            "value_3": "traci fakturę"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Dopasowanie do wnętrza",
            "value_1": "materiał + obszycie",
            "value_2": "ograniczone",
            "value_3": "częściowe"
          }
        }
      ]
    }
  ]
}
{% endschema %}
