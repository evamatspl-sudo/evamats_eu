{{ 'section-video-with-text.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{% liquid
    assign text_color = section.settings.text_color
    assign subtitle_color = section.settings.subtitle_color
    assign background = section.settings.background

    assign padding_top = section.settings.padding_top | append: 'px'
    assign padding_top_mobile = section.settings.padding_top_mobile | append: 'px'
    assign padding_bottom = section.settings.padding_bottom | append: 'px'
    assign padding_bottom_mobile = section.settings.padding_bottom_mobile | append: 'px'

    assign yt_id = ''
    assign vimeo_id = ''
    if section.settings.video_embed != blank
      if section.settings.video_embed contains 'youtube.com/embed/'
        assign yt_chunk = section.settings.video_embed | split: 'youtube.com/embed/' | last
        assign yt_id = yt_chunk | split: '?' | first | split: '"' | first | split: "'" | first | split: '/' | first
      elsif section.settings.video_embed contains 'youtu.be/'
        assign yt_chunk = section.settings.video_embed | split: 'youtu.be/' | last
        assign yt_id = yt_chunk | split: '?' | first | split: '"' | first | split: "'" | first | split: '/' | first
      elsif section.settings.video_embed contains 'player.vimeo.com/video/'
        assign vimeo_chunk = section.settings.video_embed | split: 'player.vimeo.com/video/' | last
        assign vimeo_id = vimeo_chunk | split: '?' | first | split: '"' | first | split: "'" | first | split: '/' | first
      endif
    endif
%}

<div class="video-with-text" style="
        --text-color: {{ text_color }};
        --subtitle-color: {{ subtitle_color }};
        --background: {{ background }};
        --highlight-background: {{ highlight_background }};
        --padding_top: {{ padding_top }};
        --padding_top_mobile: {{ padding_top_mobile }};
        --padding_bottom: {{ padding_bottom  }};
        --padding_bottom_mobile: {{ padding_bottom_mobile }};">

    <div class="video-with-text__page-width">

        <div class="video-with-text__content">
          <div class="video-with-text__inner">
            {% if section.settings.subtitle != blank %}
                <div class="video-with-text__subtitle">
                    {{ section.settings.subtitle }}
                </div>
            {% endif %}

            {% if section.settings.heading != blank %}
                <h2 class="video-with-text__heading">
                    {{ section.settings.heading }}
                </h2>
            {% endif %}

            {% if section.settings.text != blank %}
                <div class="video-with-text__text">
                    {{ section.settings.text }}
                </div>
            {% endif %}
          </div>
        </div>

      <div class="video-with-text__media">

        {% if section.settings.video != blank %}

          {{
          section.settings.video
          | video_tag:
          image_size: '900x',
          autoplay: false,
          loop: false,
          muted: false,
          controls: true,
          playsinline: true,
          class: 'video-with-text__video'
          }}

          {% elsif section.settings.video_url != blank %}

          <video
                  class="video-with-text__video"
                  controls
                  playsinline
          >
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>

          {% elsif yt_id != blank or vimeo_id != blank %}

          {%- assign media_id = yt_id | default: vimeo_id -%}
          <div class="video-with-text__iframe">
            <deferred-media
              class="video-with-text__deferred deferred-media no-js-hidden"
              data-media-id="{{ media_id | escape }}"
            >
              <button
                id="Deferred-Poster-VWT-{{ section.id }}-{{ media_id }}"
                class="video-with-text__poster deferred-media__poster media"
                type="button"
                aria-label="{{ 'sections.video.load_video' | t: description: section.settings.heading | escape }}"
              >
                {%- if section.settings.cover_image != blank -%}
                  {%- assign vwt_cover_alt = section.settings.heading | escape -%}
                  {{
                    section.settings.cover_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '335, 670, 900',
                      sizes: '(max-width: 749px) 100vw, 335px',
                      class: 'video-with-text__poster-img',
                      alt: vwt_cover_alt
                  }}
                {%- elsif yt_id != blank -%}
                  <img
                    class="video-with-text__poster-img"
                    src="https://i.ytimg.com/vi/{{ yt_id }}/hqdefault.jpg"
                    alt="{{ section.settings.heading | escape }}"
                    loading="lazy"
                    width="480"
                    height="360"
                  >
                {%- else -%}
                  {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}
                <span class="deferred-media__poster-button motion-reduce">
                  {%- render 'icon-play' -%}
                </span>
              </button>
              <template>
                {%- if yt_id != blank -%}
                  <iframe
                    src="https://www.youtube.com/embed/{{ yt_id }}?enablejsapi=1&autoplay=1"
                    class="js-youtube"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ section.settings.heading | escape }}"
                  ></iframe>
                {%- else -%}
                  <iframe
                    src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1"
                    class="js-vimeo"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ section.settings.heading | escape }}"
                  ></iframe>
                {%- endif -%}
              </template>
            </deferred-media>
          </div>

          {% elsif section.settings.video_embed != blank %}

          <div class="video-with-text__iframe">
            {{ section.settings.video_embed }}
          </div>

        {% endif %}

      </div>

    </div>
</div>

{% schema %}
{
  "name": "Video With Text",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1B1D22"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#EF022D"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "MATERIÁL Carvion"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Hledáte vysoce kvalitní autokoberce?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Uvažujete o nákupu velurové verze?</p>"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "MP4/WebM video URL"
    },
    {
      "type": "html",
      "id": "video_embed",
      "label": "YouTube/Vimeo iframe"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Video cover image"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Video With Text"
    }
  ]
}
{% endschema %}
