{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{{ 'section-evamats-cart.css' | asset_url | stylesheet_tag }}
{% if theme.role != 'main' and section.settings.gift_demo_enabled and cart != empty %}
  {{ 'carvion-gift-demo.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'carvion-gift-demo.js' | asset_url }}" defer></script>
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<cart-items class="evamats-cart{% if cart == empty %} is-empty{% endif %}">
  {%- unless cart == empty -%}
    {% render 'drawer_progress', section_id: section.id, part: 'upsell' %}
  {%- endunless -%}

  <div class="evamats-cart__main page-width{% unless cart == empty %} section-{{ section.id }}-padding{% endunless %}">
    {% comment %} <div class="title-wrapper-with-link">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      <a href="/collections/all-car-mats" class="underlined-link">{{ 'general.continue_shopping' | t }}</a>
    </div> {% endcomment %}

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="/collections/all-car-mats" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    {%- if cart != empty -%}
      <div class="evamats-cart__body">
        <div class="evamats-cart__body-inner">
          <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
            <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
              <div class="js-contents evamats-cart__layout">
                <div class="evamats-cart__col-main">
                  {% if theme.role != 'main' and section.settings.gift_demo_enabled %}
                    {% render 'carvion-gift-demo', section: section %}
                  {% else %}
                    {% render 'drawer_progress', section_id: section.id, part: 'gift' %}
                  {% endif %}
                  <div class="evamats-cart__surface">
                    <div class="evamats-cart-items" role="list" aria-label="{{ 'sections.cart.caption' | t }}">
                      {%- for item in cart.items -%}
                        {% render 'evamats-cart-item', item: item, line_index: item.index | plus: 1, section_id: section.id %}
                      {%- endfor -%}
                    </div>
                  </div>
                </div>

                {% render 'evamats-cart-sidebar', section_id: section.id %}
              </div>
            </div>

            <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
            <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </form>
        </div>
      </div>
    {%- endif -%}
  </div>
</cart-items>

{%- if cart != empty -%}
  <div class="sticky_container">
    <button type="button" class="sticky_add_to_cart button" aria-label="{{ 'sections.cart.checkout' | t }}">
      {% render 'icon-cart' %}
    </button>
  </div>

  <script>
    document.addEventListener('click', function (event) {
      var clearBtn = event.target.closest('[data-clear-cart]');
      if (!clearBtn) return;
      event.preventDefault();
      fetch(window.routes.cart_url + '/clear.js', { method: 'POST' })
        .then(function () {
          sessionStorage.removeItem('evamatsCartTermsAccepted');
          window.location.reload();
        })
        .catch(function (err) {
          console.error(err);
        });
    });

    document.addEventListener('DOMContentLoaded', function () {
      if (window.initEvamatsCartSidebarControls) {
        window.initEvamatsCartSidebarControls();
      }
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {"type":"header","content":"Gift reward · DEMO"},
    {"type":"paragraph","content":"Owner preview only: no cart item, price or checkout discount is created. Hidden on a published theme."},
    {"type":"checkbox","id":"gift_demo_enabled","label":"Show gift demo","default":false},
    {"type":"number","id":"gift_demo_shipping_threshold","label":"Free-delivery threshold (currency units)","default":100,"info":"First milestone in the combined progress. Use the real free-delivery threshold for this market."},
    {"type":"number","id":"gift_demo_threshold","label":"Order threshold (currency units)","default":150,"info":"Example: 150 means EUR 150. After discounts, without shipping."},
    {"type":"text","id":"gift_demo_currency","label":"Campaign currency (ISO)","default":"EUR","info":"Only carts in this currency are eligible; no automatic conversion."},
    {"type":"select","id":"gift_demo_price","label":"Illustrative gift price","default":"1","options":[{"value":"1","label":"0.01"},{"value":"0","label":"Free"}]},
    {"type":"product_list","id":"gift_demo_products","label":"Gift products and order","limit":6,"info":"Choose existing products. Their catalog prices are not changed."},
    {"type":"collection","id":"gift_demo_collection","label":"Optional gift collection","info":"If selected, the first six products replace the manual list. Edit membership/order in Products → Collections."},
    {"type":"checkbox","id":"gift_demo_controls","label":"Show artificial scenario controls","default":false,"info":"Keep off for a realistic test driven by products actually added to the cart."},
    {"type":"text","id":"gift_demo_campaign","label":"Demo campaign version","default":"preview-1","info":"Change this to reset saved demo selections."},
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}

