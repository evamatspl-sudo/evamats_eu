{%- comment -%}
  Лента выбора КУЗОВА на уровне модели (подключена только к шаблону collection.audi-model).
  Не переход на другую модель — фильтрует товары текущей модели по custom.filter_body_type.

  Значение метаполя переведено через Translate & Adapt и в разных языках разное
  (Station Wagon / Kombi, Sedan / Limousine, Liftback / Schrägheck…), поэтому оно
  нормализуется в ключ (sedan, station-wagon, …). Картинки — универсальные силуэты
  из метаобъекта body_types.
{%- endcomment -%}

{%- capture body_ribbon_visible -%}{%- render 'evamats-body-ribbon-visible' -%}{%- endcapture -%}
{%- if body_ribbon_visible == '1' -%}
{{ 'section-evamats-body-type-ribbon.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-evamats-body-type-ribbon.js' | asset_url }}" defer></script>

{%- liquid
  assign locale = request.locale.iso_code
  assign canonical = 'sedan,station-wagon,liftback,hatchback,suv,suv-coupe,coupe,cabrio,minivan,van,pickup' | split: ','

  case locale
    when 'cs'
      assign t_eyebrow = 'Filtr'
      assign t_heading = 'Vyberte karosérii'
      assign t_note    = 'Vyberte tvar karoserie svého vozu — nabídka níže se ihned přizpůsobí. Nejde o přechod na jiný model.'
      assign t_all     = 'Vše'
      assign t_empty   = 'Pro tuto karosérii zatím nemáme žádný produkt.'
    when 'de'
      assign t_eyebrow = 'Filter'
      assign t_heading = 'Karosserie wählen'
      assign t_note    = 'Wählen Sie die Karosserieform Ihres Fahrzeugs — die Auswahl unten passt sich sofort an. Kein Wechsel zu einem anderen Modell.'
      assign t_all     = 'Alle'
      assign t_empty   = 'Für diese Karosserie haben wir noch kein Produkt.'
    else
      assign t_eyebrow = 'Filter'
      assign t_heading = 'Choose body type'
      assign t_note    = 'Pick your car body shape — the list below adapts instantly. This is not a switch to another model.'
      assign t_all     = 'All'
      assign t_empty   = 'No product for this body type yet.'
  endcase
-%}

{%- comment -%} один проход: handle~ключ_кузова {%- endcomment -%}
{%- capture pairs -%}
  {%- for product in collection.products limit: 50 -%}
    {{- product.handle -}}~{%- render 'evamats-body-type-keys', product: product -%}|
  {%- endfor -%}
{%- endcapture -%}

{%- assign pair_list = pairs | strip | split: '|' -%}
{%- assign total_products = pair_list | size -%}

<section class="eva-body-ribbon" data-eva-body-ribbon>
  <div class="page-width">
    <div class="eva-body-ribbon__head">
      <span class="eva-body-ribbon__eyebrow">{{ t_eyebrow }}</span>
      <h2 class="eva-body-ribbon__title">{{ t_heading }}</h2>
      <p class="eva-body-ribbon__note">{{ t_note }}</p>
    </div>

    <div class="eva-body-ribbon__scroller">
      <ul class="eva-body-ribbon__list" role="list">
        <li>
          <button type="button" class="eva-body-chip eva-body-chip--all is-active" data-body="" aria-pressed="true">
            <span class="eva-body-chip__all-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <path d="M4 7h16M4 12h16M4 17h10"/>
              </svg>
            </span>
            <span class="eva-body-chip__label">{{ t_all }}</span>
            <span class="eva-body-chip__count">{{ total_products }}</span>
          </button>
        </li>

        {%- for key in canonical -%}
          {%- assign body_key = key | strip -%}
          {%- assign body_count = 0 -%}
          {%- for pair in pair_list -%}
            {%- assign parts = pair | strip | split: '~' -%}
            {%- assign item_keys = parts[1] | split: ',' -%}
            {%- if item_keys contains body_key -%}
              {%- assign body_count = body_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if body_count > 0 -%}
            {%- liquid
              case body_key
                when 'sedan'
                  assign mo_handle = 'sedan'
                  assign label_cs = 'Sedan'
                  assign label_de = 'Limousine'
                  assign label_en = 'Sedan'
                when 'station-wagon'
                  assign mo_handle = 'station-wagon'
                  assign label_cs = 'Kombi'
                  assign label_de = 'Kombi'
                  assign label_en = 'Station Wagon'
                when 'liftback'
                  assign mo_handle = 'liftback'
                  assign label_cs = 'Liftback'
                  assign label_de = 'Schrägheck'
                  assign label_en = 'Liftback'
                when 'hatchback'
                  assign mo_handle = 'hatchback-5-door'
                  assign label_cs = 'Hatchback'
                  assign label_de = 'Kompakt'
                  assign label_en = 'Hatchback'
                when 'suv'
                  assign mo_handle = 'usual-suv'
                  assign label_cs = 'SUV'
                  assign label_de = 'SUV'
                  assign label_en = 'SUV'
                when 'suv-coupe'
                  assign mo_handle = 'suv-coupe'
                  assign label_cs = 'SUV Kupé'
                  assign label_de = 'SUV Coupé'
                  assign label_en = 'SUV Coupe'
                when 'coupe'
                  assign mo_handle = 'coupe'
                  assign label_cs = 'Kupé'
                  assign label_de = 'Coupé'
                  assign label_en = 'Coupe'
                when 'cabrio'
                  assign mo_handle = 'cabrio'
                  assign label_cs = 'Kabriolet'
                  assign label_de = 'Cabrio'
                  assign label_en = 'Cabrio'
                when 'minivan'
                  assign mo_handle = 'minivan-5-seater'
                  assign label_cs = 'Minivan'
                  assign label_de = 'Minivan'
                  assign label_en = 'Minivan'
                when 'van'
                  assign mo_handle = 'big-van'
                  assign label_cs = 'Van'
                  assign label_de = 'Van'
                  assign label_en = 'Van'
                when 'pickup'
                  assign mo_handle = 'double-cabin'
                  assign label_cs = 'Pick-up'
                  assign label_de = 'Pick-up'
                  assign label_en = 'Pickup'
                else
                  assign mo_handle = ''
                  assign label_cs = body_key
                  assign label_de = body_key
                  assign label_en = body_key
              endcase

              case locale
                when 'cs'
                  assign label = label_cs
                when 'de'
                  assign label = label_de
                else
                  assign label = label_en
              endcase

              assign body_object = shop.metaobjects.body_types[mo_handle]
            -%}

            <li>
              <button type="button" class="eva-body-chip" data-body="{{ body_key }}" aria-pressed="false">
                <span class="eva-body-chip__media">
                  {%- if body_object.image.value != blank -%}
                    {{ body_object.image.value | image_url: width: 240 | image_tag: loading: 'lazy', alt: label, class: 'eva-body-chip__img' }}
                  {%- endif -%}
                </span>
                <span class="eva-body-chip__label">{{ label }}</span>
                <span class="eva-body-chip__count">{{ body_count }}</span>
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <p class="eva-body-ribbon__empty" data-eva-body-empty hidden>{{ t_empty }}</p>
  </div>

  {%- capture body_map -%}
    {
    {%- assign first = true -%}
    {%- for pair in pair_list -%}
      {%- assign parts = pair | strip | split: '~' -%}
      {%- if parts[0] != blank -%}
        {%- unless first %},{% endunless -%}
        "{{ parts[0] }}": "{{ parts[1] | default: '' }}"
        {%- assign first = false -%}
      {%- endif -%}
    {%- endfor -%}
    }
  {%- endcapture -%}
  <script type="application/json" data-eva-body-map>{{ body_map | strip }}</script>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Body type ribbon",
  "tag": "section",
  "class": "eva-body-ribbon-section",
  "settings": [],
  "presets": [{ "name": "Body type ribbon" }]
}
{% endschema %}
