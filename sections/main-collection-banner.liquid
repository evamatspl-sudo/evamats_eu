{{ 'section-evamats-collection-banner.css' | asset_url | stylesheet_tag }}
{{ 'section-evamats-collection-mobile.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_image = section.settings.image_desktop
  assign mobile_image = section.settings.image_mobile

  if desktop_image == blank
    assign desktop_image = collection.image
  endif
  if mobile_image == blank
    assign mobile_image = desktop_image
  endif

  assign root_label = section.settings.parent_label | strip
  if root_label == blank
    assign root_label = 'Carvion'
  endif
  assign root_url = section.settings.parent_url | strip
  if root_url == blank
    assign root_url = routes.root_url
  endif
  assign catalog_label = section.settings.catalog_label | strip
  if catalog_label == blank
    assign catalog_label = 'Catalog'
  endif
  if localization.language.iso_code == 'lv'
    assign catalog_label = 'Katalogs'
  endif

  assign middle_label = ''
  assign middle_url = ''
  assign breadcrumb_current = collection.title

  assign show_back = false
  assign back_url = blank
  assign is_brand_main_page = false
  assign collection_brand_group = collection.metafields.custom.brand_group.value
  assign collection_brand_name = collection_brand_group.title.value | strip

  if collection_brand_group != blank
    assign collection_brand_main = collection_brand_group.main_collection.value
    if collection_brand_main != blank and collection.id == collection_brand_main.id
      assign is_brand_main_page = true
      assign back_url = collections['all-car-mats'].url
      if back_url == blank
        assign back_url = routes.all_products_collection_url
      endif
      assign show_back = true
    elsif collection_brand_main != blank
      assign back_url = collection_brand_main.url
      assign show_back = true
    endif
  elsif section.settings.brand_url != blank
    assign back_url = section.settings.brand_url
    assign show_back = true
  endif

  assign mobile_catalog_label = 'Catalog'
  case localization.language.iso_code
    when 'lv'
      assign mobile_catalog_label = 'Katalogs'
    when 'cs'
      assign mobile_catalog_label = 'Katalog'
    when 'de'
      assign mobile_catalog_label = 'Katalog'
  endcase
  comment
    Мобильная стрелка «назад» подписывается тем, КУДА она ведёт.
    Со страницы марки (Volvo) она ведёт в каталог → «Katalog».
    Со страницы модели она ведёт на марку → «Katalog Volvo».
  endcomment
  assign mobile_back_label = mobile_catalog_label
  if collection_brand_name != blank and is_brand_main_page == false
    assign mobile_back_label = mobile_back_label | append: ' ' | append: collection_brand_name
  endif

  if section.settings.show_back_button == false
    assign show_back = false
  endif

  assign back_label = section.settings.back_label | strip
  if back_label == blank
    assign back_label = '← Back'
  endif
  case localization.language.iso_code
    when 'cs'
      assign back_label = '← Zpět'
    when 'de'
      assign back_label = '← Zurück'
    when 'lv'
      assign back_label = '← Atpakaļ'
  endcase
-%}

<div
  id="EvamatsCollectionBanner-{{ section.id }}"
  class="evamats-collection-banner shopify-section"
>
  <div class="evamats-collection-banner__media{% if desktop_image == blank %} evamats-collection-banner__media--fallback{% endif %}" aria-hidden="true">
    <div
      class="evamats-collection-banner__mobile-texture-fill"
      style="background-image: url('{{ 'carvion-collection-hero-mobile.webp' | asset_url }}');"
    ></div>
    {%- if desktop_image != blank -%}
      <picture>
        {%- if mobile_image != blank -%}
          <source media="(max-width: 749px)" srcset="{{ 'carvion-collection-hero-mobile.webp' | asset_url }}">
        {%- endif -%}
        {%- comment -%}
          ПК-баннер задаётся здесь ОДИН раз для всех коллекций (было: в каждом
          шаблоне отдельно, 554 файла). Картинка выровнена по канту и уменьшена
          до 95%. Мобильная версия по-прежнему берётся из настройки секции.
        {%- endcomment -%}
        <img
          src="{{ 'carvion-collection-hero-desktop.webp' | asset_url }}"
          class="evamats-collection-banner__image"
          width="1914"
          height="808"
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          alt=""
        >
      </picture>
    {%- endif -%}
    <div class="evamats-collection-banner__overlay"></div>
  </div>

  <div class="evamats-collection-banner__ui page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'evamats-breadcrumbs',
        auto_collection: true,
        parent_label: root_label,
        parent_url: root_url,
        middle_label: middle_label,
        middle_url: middle_url,
        current_label: breadcrumb_current,
        class: 'evamats-collection-banner__breadcrumbs'
      %}
    {%- endif -%}

    {%- if show_back and back_url != blank -%}
      <a class="evamats-collection-banner__back" href="{{ back_url }}">
        {{ back_label | escape }}
      </a>
      <a class="evamats-collection-banner__mobile-back" href="{{ back_url }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M19 12H5M11 18L5 12L11 6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ mobile_back_label | escape }}</span>
      </a>
    {%- endif -%}

    <h1 class="evamats-collection-banner__title">
      <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
      {{- collection.title | escape -}}
    </h1>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section-evamats-collection-banner",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Background image (desktop)",
      "info": "Uses collection image when empty."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Uses desktop or collection image when empty."
    },
    {
      "type": "header",
      "content": "Breadcrumbs"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "parent_label",
      "label": "Breadcrumb root label",
      "default": "Carvion"
    },
    {
      "type": "url",
      "id": "parent_url",
      "label": "Breadcrumb root link",
      "info": "Defaults to homepage."
    },
    {
      "type": "text",
      "id": "catalog_label",
      "label": "Catalog breadcrumb label",
      "default": "Katalog",
      "info": "Shown on brand and top-level collection pages."
    },
    {
      "type": "header",
      "content": "Back button"
    },
    {
      "type": "checkbox",
      "id": "show_back_button",
      "label": "Show back button on brand and model pages",
      "default": true
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button label",
      "default": "← Zpět"
    },
    {
      "type": "url",
      "id": "brand_url",
      "label": "Parent brand collection",
      "info": "Fallback for model pages when brand_group metafield is missing."
    }
  ]
}
{% endschema %}
