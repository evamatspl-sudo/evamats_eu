    {%- assign txt_gallery_prev = 'Vorheriges Bild' -%}
    {%- assign txt_gallery_next = 'Nächstes Bild' -%}
    {%- assign txt_gallery_empty = 'Galerie folgt in Kürze' -%}
    {%- assign txt_close = 'Schließen' -%}
    {%- assign prop_vehicle = 'Fahrzeug' -%}
    {%- assign prop_trim = 'Farbe der Einfassung' -%}
    {%- assign prop_notes = 'Hinweise' -%}
    {%- assign label_2os_front_boot = 'Vorne + Kofferraum' -%}
  {%- else -%}
    {%- assign txt_preview_alt = 'Configuration preview' -%}
    {%- assign txt_preview_caption = 'Black velour · black trim' -%}
    {%- assign txt_preview_note = 'The displayed mat is a configuration preview only, not a photograph of the finished product.' -%}
    {%- assign txt_choose_vehicle = 'Choose your vehicle' -%}
    {%- assign txt_brand = 'Make' -%}
    {%- assign txt_model = 'Model' -%}
    {%- assign txt_generation = 'Generation' -%}
    {%- assign txt_body = 'Body style' -%}
    {%- assign txt_brand_ph = 'Enter a make…' -%}
    {%- assign txt_model_first = 'Choose a make first' -%}
    {%- assign txt_generation_first = 'Choose a model first' -%}
    {%- assign txt_body_first = 'Choose a generation first' -%}
    {%- assign txt_choose_model = 'Choose a model…' -%}
    {%- assign txt_choose_generation = 'Choose a generation…' -%}
    {%- assign txt_choose_body = 'Choose a body style…' -%}
    {%- assign txt_no_data = 'No data available' -%}
