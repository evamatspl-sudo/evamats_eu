              <p class="evamats-config-checkout__total-label">{{ txt_total }}</p>
              <div class="evamats-config-checkout__prices">
                <span class="evamats-config-checkout__price-old ecm-compare-price" data-ecm-compare-price hidden></span>
                <span class="evamats-config-checkout__price-current" data-ecm-price>{{ product.selected_or_first_available_variant.price | money }}</span>
                <span class="evamats-config-checkout__discount ecm-discount-badge" data-ecm-discount-badge hidden></span>
              </div>
            </div>
            <button type="submit" class="button button--full-width evamats-config-checkout__submit ecm-submit">
