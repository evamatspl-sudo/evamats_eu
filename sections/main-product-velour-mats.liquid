<section
  class="ecm ecm--velour evamats-config"
  data-ecm
  data-vehicles="{{ 'velour-vehicles.json' | asset_url }}"
  data-locale="{{ request.locale.iso_code }}"
  data-currency="{{ localization.country.currency.iso_code }}"
  data-no-results="{{ txt_no_results | escape }}"
  data-no-data="{{ txt_no_data | escape }}"
  data-choose-model="{{ txt_choose_model | escape }}"
  data-choose-generation="{{ txt_choose_generation | escape }}"
  data-choose-body="{{ txt_choose_body | escape }}"
  data-model-first="{{ txt_model_first | escape }}"
  data-generation-first="{{ txt_generation_first | escape }}"
  data-body-first="{{ txt_body_first | escape }}"
>
  <div class="ecm-wrap">
    <div class="ecm-left">
      <div class="ecm-title-card">
        <h1 class="ecm-title">{{ product.title | escape }}</h1>
        <div class="ecm-price-stack" data-ecm-price-stack>
          <s class="ecm-compare-price" data-ecm-compare-price hidden></s>
          <div class="ecm-price-line">
            <div class="ecm-price" data-ecm-price>{{ product.selected_or_first_available_variant.price | money }}</div>
            <span class="ecm-discount-badge" data-ecm-discount-badge hidden></span>
          </div>
        </div>
      </div>

      <div class="ecm-preview-card">
        <img class="ecm-preview-img" data-ecm-preview src="{{ 'velour-preview-black.webp' | asset_url }}" alt="{{ txt_preview_alt | escape }}">
        <p class="ecm-preview-caption" data-ecm-preview-caption>{{ txt_preview_caption }}</p>
        <p class="ecm-preview-note">{{ txt_preview_note }}</p>
      </div>
    </div>

    <div class="ecm-right">
      <form method="post" action="/cart/add" id="ecm-form" data-ecm-form>
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-ecm-variant-id>

        <div class="ecm-step is-open" data-ecm-step>
          <div class="ecm-step-head">
            <span class="ecm-step-num">1</span>
            <span class="ecm-step-title">{{ txt_choose_vehicle }}</span>
            <span class="ecm-step-value" data-ecm-step-value></span>
            <span class="ecm-step-caret" aria-hidden="true"></span>
          </div>
          <div class="ecm-step-body">
            <div class="ecm-field"><label>{{ txt_brand }}</label>
              <div class="ecm-combo" data-ecm-combo="brand">
                <input type="text" class="ecm-combo-input" placeholder="{{ txt_brand_ph | escape }}" autocomplete="off" data-ecm-brand>
                <ul class="ecm-combo-list" hidden></ul>
              </div>
            </div>
            <div class="ecm-field"><label>{{ txt_model }}</label>
              <div class="ecm-combo" data-ecm-combo="model">
                <input type="text" class="ecm-combo-input" placeholder="{{ txt_model_first | escape }}" autocomplete="off" disabled data-ecm-model>
                <ul class="ecm-combo-list" hidden></ul>
              </div>
            </div>
            <div class="ecm-field"><label>{{ txt_generation }}</label>
              <div class="ecm-combo" data-ecm-combo="gen">
                <input type="text" class="ecm-combo-input" placeholder="{{ txt_generation_first | escape }}" autocomplete="off" readonly disabled data-ecm-gen>
                <ul class="ecm-combo-list" hidden></ul>
              </div>
            </div>
            <div class="ecm-field"><label>{{ txt_body }}</label>
              <div class="ecm-combo" data-ecm-combo="body">
                <input type="text" class="ecm-combo-input" placeholder="{{ txt_body_first | escape }}" autocomplete="off" readonly disabled data-ecm-body>
                <ul class="ecm-combo-list" hidden></ul>
              </div>
            </div>
            <input type="hidden" name="properties[{{ prop_vehicle | escape }}]" data-ecm-vehicle-prop>
            <p class="ecm-step-error" data-ecm-step-error hidden>{{ txt_vehicle_error }}</p>
            <button type="button" class="ecm-step-next">{{ txt_next }}</button>
          </div>
        </div>

        <div class="ecm-step is-disabled" data-ecm-step>
          <div class="ecm-step-head">
            <span class="ecm-step-num">2</span>
            <span class="ecm-step-title">{{ txt_choose_set }}</span>
            <span class="ecm-set-name" data-ecm-set-name></span>
            <span class="ecm-set-pricepill" data-ecm-set-pricepill></span>
            <span class="ecm-step-caret" aria-hidden="true"></span>
          </div>
          <div class="ecm-step-body">
            <div class="ecm-sets" data-ecm-sets>
              {%- for v in product.variants -%}
                {%- liquid
                  case forloop.index
                    when 1
                      assign set_code = 'front'
                      assign image_2os = 'evm-set-5os-front-row.svg'
                      assign image_5os = 'evm-set-5os-front-row.svg'
                      assign image_7os = 'evm-set-7os-front-row.svg'
                    when 2
                      assign set_code = 'front_rear'
                      assign image_2os = ''
                      assign image_5os = 'evm-set-5os-front-rear.svg'
                      assign image_7os = 'evm-set-7os-front-second.svg'
                    when 3
                      assign set_code = 'front_rear_boot'
                      assign image_2os = 'evm-set-2os-przod-bagaznik.svg'
                      assign image_5os = 'evm-set-5os-front-rear-trunk.svg'
                      assign image_7os = 'evm-set-7os-front-second-large-trunk.svg'
                    when 4
                      assign set_code = 'front_rear_third'
                      assign image_2os = ''
                      assign image_5os = ''
                      assign image_7os = 'evm-set-7os-front-second-third.svg'
                    when 5
                      assign set_code = 'front_rear_third_small_boot'
                      assign image_2os = ''
                      assign image_5os = ''
                      assign image_7os = 'evm-set-7os-all-rows-trunk.svg'
                    when 6
                      assign set_code = 'front_rear_third_large_boot'
                      assign image_2os = ''
                      assign image_5os = ''
                      assign image_7os = 'evm-set-7os-all-rows-large-trunk-v2.svg'
                    when 7
                      assign set_code = 'three_rows_two_boots'
                      assign image_2os = ''
                      assign image_5os = ''
                      assign image_7os = 'evm-set-7os-all-rows-two-trunks-v2.svg'
                    when 8
                      assign set_code = 'front_rear_large_boot'
                      assign image_2os = ''
                      assign image_5os = ''
                      assign image_7os = 'evm-set-7os-front-second-large-trunk.svg'
                    when 9
                      assign set_code = 'rear'
                      assign image_2os = ''
                      assign image_5os = 'evm-set-5os-rear-row.svg'
                      assign image_7os = 'evm-set-7os-second-row.svg'
                    else
                      assign set_code = 'boot'
                      assign image_2os = 'evm-set-5os-trunk.svg'
                      assign image_5os = 'evm-set-5os-trunk.svg'
                      assign image_7os = 'evm-set-7os-large-trunk.svg'
                  endcase
                -%}
                <button
                  type="button"
                  class="ecm-set{% if forloop.first %} is-active{% endif %}"
                  data-ecm-set
                  data-set-code="{{ set_code }}"
                  data-variant-id="{{ v.id }}"
                  data-price="{{ v.price }}"
                  data-compare="{{ v.compare_at_price }}"
                  data-name="{{ v.title | escape }}"
                  data-name-2os="{% if set_code == 'front_rear_boot' %}{{ label_2os_front_boot | escape }}{% else %}{{ v.title | escape }}{% endif %}"
                  data-image-2os="{% if image_2os != blank %}{{ image_2os | asset_url }}{% endif %}"
                  data-image-5os="{% if image_5os != blank %}{{ image_5os | asset_url }}{% endif %}"
                  data-image-7os="{% if image_7os != blank %}{{ image_7os | asset_url }}{% endif %}"
                  title="{{ v.title | escape }}"
                >
                  <img src="{% if image_5os != blank %}{{ image_5os | asset_url }}{% else %}{{ image_7os | asset_url }}{% endif %}" alt="{{ v.title | escape }}" loading="lazy">
                </button>
              {%- endfor -%}
            </div>
            <p class="ecm-hint">{{ txt_set_hint }}</p>
            <button type="button" class="ecm-step-next">{{ txt_next }}</button>
          </div>
        </div>

        <div class="ecm-step is-disabled" data-ecm-step>
          <div class="ecm-step-head">
            <span class="ecm-step-num">3</span>
            <span class="ecm-step-title">{{ txt_trim }}</span>
            <span class="ecm-set-name" data-ecm-color-name>{{ txt_black }}</span>
            <span class="ecm-step-caret" aria-hidden="true"></span>
          </div>
          <div class="ecm-step-body">
            {%- liquid
              assign ecm_color_codes = 'black|red|lightgrey|darkgrey|brown|beige|blue|darkblue|green|orange|yellow|maroon|purple|pink|copper' | split: '|'
              assign ecm_color_swatches = 'velour-swatch-black.webp|velour-swatch-red.webp|velour-swatch-lightgrey.webp|velour-swatch-darkgrey.webp|velour-swatch-brown.webp|velour-swatch-beige.webp|velour-swatch-blue.webp|velour-swatch-darkblue.webp|velour-swatch-green.webp|velour-swatch-orange.webp|velour-swatch-yellow.webp|velour-swatch-maroon.webp|velour-swatch-purple.webp|velour-swatch-pink.webp|velour-swatch-copper.webp' | split: '|'
              assign ecm_color_previews = 'velour-preview-black.webp|velour-preview-red.webp|velour-preview-lightgrey.webp|velour-preview-darkgrey.webp|velour-preview-brown.webp|velour-preview-beige.webp|velour-preview-blue.webp|velour-preview-darkblue.webp|velour-preview-green.webp|velour-preview-orange.webp|velour-preview-yellow.webp|velour-preview-maroon.webp|velour-preview-purple.webp|velour-preview-pink.webp|velour-preview-coopper.webp' | split: '|'
              case ecm_locale
                when 'cs'
                  assign ecm_color_labels = 'Černá|Červená|Světle šedá|Tmavě šedá|Hnědá|Béžová|Modrá|Tmavě modrá|Zelená|Oranžová|Žlutá|Vínová|Fialová|Růžová|Měděná' | split: '|'
