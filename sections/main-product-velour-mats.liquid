{{ 'velour-mats-configurator.css' | asset_url | stylesheet_tag }}

{%- assign ecm_locale = request.locale.iso_code | split: '-' | first -%}
{%- case ecm_locale -%}
  {%- when 'cs' -%}
  {%- when 'de' -%}
  {%- else -%}{%- assign ecm_locale = 'en' -%}
{%- endcase -%}
{%- assign ecm_opis = '' -%}
{%- assign ecm_tech = '' -%}
{%- if product.description contains '<!-- EVAMATS_OPIS_START -->' and product.description contains '<!-- EVAMATS_OPIS_END -->' -%}
  {%- assign _o = product.description | split: '<!-- EVAMATS_OPIS_START -->' -%}
  {%- assign _o = _o[1] | split: '<!-- EVAMATS_OPIS_END -->' -%}
  {%- assign ecm_opis = _o[0] | strip -%}
{%- endif -%}
{%- if product.description contains '<!-- EVAMATS_TECH_START -->' and product.description contains '<!-- EVAMATS_TECH_END -->' -%}
  {%- assign _t = product.description | split: '<!-- EVAMATS_TECH_START -->' -%}
  {%- assign _t = _t[1] | split: '<!-- EVAMATS_TECH_END -->' -%}
  {%- assign ecm_tech = _t[0] | strip -%}
{%- endif -%}

