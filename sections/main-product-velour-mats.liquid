    {%- assign txt_preview_caption = 'Schwarzer Velours · schwarze Einfassung' -%}
    {%- assign txt_preview_note = 'Die dargestellte Fußmatte dient nur als Konfigurationsvorschau und ist kein Foto des fertigen Produkts.' -%}
