    {%- assign txt_brand = 'Značka' -%}
    {%- assign txt_model = 'Model' -%}
    {%- assign txt_generation = 'Generace' -%}
    {%- assign txt_body = 'Karoserie' -%}
    {%- assign txt_brand_ph = 'Zadejte značku…' -%}
    {%- assign txt_model_first = 'Nejprve vyberte značku' -%}
    {%- assign txt_generation_first = 'Nejprve vyberte model' -%}
    {%- assign txt_body_first = 'Nejprve vyberte generaci' -%}
    {%- assign txt_choose_model = 'Vyberte model…' -%}
    {%- assign txt_choose_generation = 'Vyberte generaci…' -%}
    {%- assign txt_choose_body = 'Vyberte karoserii…' -%}
