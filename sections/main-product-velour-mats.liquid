                <img src="{{ 'Group_1948755301.webp' | file_url }}" alt="" loading="lazy" width="56" height="56">
                <div>
                  <strong>{{ txt_made_to_order }}</strong>
                  <p>{{ txt_production_time }}</p>
                </div>
              </div>
              <div class="evamats-config-checkout__note ecm-trusted-note">
                <img src="{{ '6f13a48de7783505c9cd_1.svg' | file_url }}" alt="Trusted Shops" loading="lazy" width="58" height="58">
                <div>
                  <strong>{{ txt_order_confidence }}</strong>
                  <p>{{ txt_buyer_protection }}</p>
