<section
  class="ecm ecm--velour"
  data-ecm
  data-vehicles="{{ 'velour-vehicles.json' | asset_url }}"
  data-locale="{{ request.locale.iso_code }}"
  data-currency="{{ localization.country.currency.iso_code }}"
  data-no-results="{{ txt_no_results | escape }}"
  data-no-data="{{ txt_no_data | escape }}"
  data-choose-model="{{ txt_choose_model | escape }}"
  data-choose-generation="{{ txt_choose_generation | escape }}"
  data-choose-body="{{ txt_choose_body | escape }}"
  data-model-first="{{ txt_model_first | escape }}"
  data-generation-first="{{ txt_generation_first | escape }}"
  data-body-first="{{ txt_body_first | escape }}"
>
  <div class="ecm-wrap">
    <div class="ecm-left">
      <div class="ecm-title-card">
        <h1 class="ecm-title">{{ product.title | escape }}</h1>
        <div class="ecm-price-stack" data-ecm-price-stack>
          <s class="ecm-compare-price" data-ecm-compare-price hidden></s>
          <div class="ecm-price-line">
            <div class="ecm-price" data-ecm-price>{{ product.selected_or_first_available_variant.price | money }}</div>
            <span class="ecm-discount-badge" data-ecm-discount-badge hidden></span>
          </div>
        </div>
      </div>

      <div class="ecm-preview-card">
        <img class="ecm-preview-img" data-ecm-preview src="{{ 'velour-preview-black.webp' | asset_url }}" alt="{{ txt_preview_alt | escape }}">
        <p class="ecm-preview-caption" data-ecm-preview-caption>{{ txt_preview_caption }}</p>
        <p class="ecm-preview-note">{{ txt_preview_note }}</p>
      </div>
    </div>

    <div class="ecm-right">
      <form method="post" action="/cart/add" id="ecm-form" data-ecm-form>
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-ecm-variant-id>

        <div class="ecm-step is-open" data-ecm-step>
          <div class="ecm-step-head">
            <span class="ecm-step-num">1</span>
            <span class="ecm-step-title">{{ txt_choose_vehicle }}</span>
            <span class="ecm-step-value" data-ecm-step-value></span>
            <span class="ecm-step-caret" aria-hidden="true"></span>
          </div>
          <div class="ecm-step-body">
            <div class="ecm-field"><label>{{ txt_brand }}</label>
              <div class="ecm-combo" data-ecm-combo="brand">
                <input type="text" class="ecm-combo-input" placeholder="{{ txt_brand_ph | escape }}" autocomplete="off" data-ecm-brand>
                <ul class="ecm-combo-list" hidden></ul>
              </div>
            </div>
            <div class="ecm-field"><label>{{ txt_model }}</label>
              <div class="ecm-combo" data-ecm-combo="model">
                <input type="text" class="ecm-combo-input" placeholder="{{ txt_model_first | escape }}" autocomplete="off" disabled data-ecm-model>
                <ul class="ecm-combo-list" hidden></ul>
              </div>
            </div>
            <div class="ecm-field"><label>{{ txt_generation }}</label>
              <div class="ecm-combo" data-ecm-combo="gen">
                <input type="text" class="ecm-combo-input" placeholder="{{ txt_generation_first | escape }}" autocomplete="off" readonly disabled data-ecm-gen>
                <ul class="ecm-combo-list" hidden></ul>
              </div>
            </div>
            <div class="ecm-field"><label>{{ txt_body }}</label>
              <div class="ecm-combo" data-ecm-combo="body">
                <input type="text" class="ecm-combo-input" placeholder="{{ txt_body_first | escape }}" autocomplete="off" readonly disabled data-ecm-body>
                <ul class="ecm-combo-list" hidden></ul>
              </div>
            </div>
            <input type="hidden" name="properties[{{ prop_vehicle | escape }}]" data-ecm-vehicle-prop>
            <p class="ecm-step-error" data-ecm-step-error hidden>{{ txt_vehicle_error }}</p>
            <button type="button" class="ecm-step-next">{{ txt_next }}</button>
          </div>
        </div>

        <div class="ecm-step is-disabled" data-ecm-step>
          <div class="ecm-step-head">
            <span class="ecm-step-num">2</span>
            <span class="ecm-step-title">{{ txt_choose_set }}</span>
            <span class="ecm-set-name" data-ecm-set-name></span>
            <span class="ecm-set-pricepill" data-ecm-set-pricepill></span>
            <span class="ecm-step-caret" aria-hidden="true"></span>
          </div>
          <div class="ecm-step-body">
            <div class="ecm-sets" data-ecm-sets>
              {%- for v in product.variants -%}
                {%- liquid
                  case forloop.index
                    when 1
                      assign set_code = 'front'
                      assign image_2os = 'evm-set-5os-front-row.svg'
                      assign image_5os = 'evm-set-5os-front-row.svg'
                      assign image_7os = 'evm-set-7os-front-row.svg'
                    when 2
                      assign set_code = 'front_rear'
                      assign image_2os = ''
                      assign image_5os = 'evm-set-5os-front-rear.svg'
                      assign image_7os = 'evm-set-7os-front-second.svg'
                    when 3
                      assign set_code = 'front_rear_boot'
                      assign image_2os = 'evm-set-2os-przod-bagaznik.svg'
                      assign image_5os = 'evm-set-5os-front-rear-trunk.svg'
                      assign image_7os = 'evm-set-7os-front-second-large-trunk.svg'
                    when 4
                      assign set_code = 'front_rear_third'
                      assign image_2os = ''
                      assign image_5os = ''
                      assign image_7os = 'evm-set-7os-front-second-third.svg'
                    when 5
                      assign set_code = 'front_rear_third_small_boot'
                      assign image_2os = ''
                      assign image_5os = ''
                      assign image_7os = 'evm-set-7os-all-rows-trunk.svg'
                    when 6
                      assign set_code = 'front_rear_third_large_boot'
                      assign image_2os = ''
                      assign image_5os = ''
                      assign image_7os = 'evm-set-7os-all-rows-large-trunk-v2.svg'
                    when 7
                      assign set_code = 'three_rows_two_boots'
                      assign image_2os = ''
                      assign image_5os = ''
                      assign image_7os = 'evm-set-7os-all-rows-two-trunks-v2.svg'
                    when 8
                      assign set_code = 'front_rear_large_boot'
                      assign image_2os = ''
                      assign image_5os = ''
                      assign image_7os = 'evm-set-7os-front-second-large-trunk.svg'
                    when 9
                      assign set_code = 'rear'
                      assign image_2os = ''
                      assign image_5os = 'evm-set-5os-rear-row.svg'
                      assign image_7os = 'evm-set-7os-second-row.svg'
                    else
                      assign set_code = 'boot'
                      assign image_2os = 'evm-set-5os-trunk.svg'
                      assign image_5os = 'evm-set-5os-trunk.svg'
                      assign image_7os = 'evm-set-7os-large-trunk.svg'
                  endcase
                -%}
                <button
                  type="button"
                  class="ecm-set{% if forloop.first %} is-active{% endif %}"
                  data-ecm-set
                  data-set-code="{{ set_code }}"
                  data-variant-id="{{ v.id }}"
                  data-price="{{ v.price }}"
                  data-compare="{{ v.compare_at_price }}"
                  data-name="{{ v.title | escape }}"
                  data-name-2os="{% if set_code == 'front_rear_boot' %}{{ label_2os_front_boot | escape }}{% else %}{{ v.title | escape }}{% endif %}"
                  data-image-2os="{% if image_2os != blank %}{{ image_2os | asset_url }}{% endif %}"
                  data-image-5os="{% if image_5os != blank %}{{ image_5os | asset_url }}{% endif %}"
                  data-image-7os="{% if image_7os != blank %}{{ image_7os | asset_url }}{% endif %}"
                  title="{{ v.title | escape }}"
                >
                  <img src="{% if image_5os != blank %}{{ image_5os | asset_url }}{% else %}{{ image_7os | asset_url }}{% endif %}" alt="{{ v.title | escape }}" loading="lazy">
                </button>
              {%- endfor -%}
            </div>
            <p class="ecm-hint">{{ txt_set_hint }}</p>
            <button type="button" class="ecm-step-next">{{ txt_next }}</button>
          </div>
        </div>

        <div class="ecm-step is-disabled" data-ecm-step>
          <div class="ecm-step-head">
            <span class="ecm-step-num">3</span>
            <span class="ecm-step-title">{{ txt_trim }}</span>
            <span class="ecm-set-name" data-ecm-color-name>{{ txt_black }}</span>
            <span class="ecm-step-caret" aria-hidden="true"></span>
          </div>
          <div class="ecm-step-body">
            <div class="ecm-colors" data-ecm-colors></div>
            <input type="hidden" name="properties[{{ prop_trim | escape }}]" data-ecm-color-prop value="{{ txt_black | escape }}">
            <div class="ecm-preview-card ecm-preview-card--mobile">
              <img class="ecm-preview-img" data-ecm-preview src="{{ 'velour-preview-black.webp' | asset_url }}" alt="{{ txt_preview_alt | escape }}">
              <p class="ecm-preview-caption" data-ecm-preview-caption>{{ txt_preview_caption }}</p>
              <p class="ecm-preview-note">{{ txt_preview_note }}</p>
            </div>
          </div>
        </div>

        <div class="ecm-flat">
          <label class="ecm-card-title" for="ecm-uwagi">{{ txt_notes }}</label>
          <textarea id="ecm-uwagi" class="ecm-uwagi" name="properties[{{ prop_notes | escape }}]" placeholder="{{ txt_notes_ph | escape }}"></textarea>
        </div>

        <button type="submit" class="ecm-submit">{{ txt_add }} — <span data-ecm-submit-price>{{ product.selected_or_first_available_variant.price | money }}</span></button>

        <div class="ecm-checkout-widgets" aria-label="Bezpieczne płatności">
          <div class="ecm-trust-widget">
            <etrusted-widget data-etrusted-widget-id="wdg-72c723c3-1f83-44e9-89c0-48433e3244a7"></etrusted-widget>
          </div>
          <div class="ecm-payment-strip" aria-label="Obsługiwane metody płatności">
            <img src="//evamats.pl/cdn/shop/files/visa.svg?v=16041805416899576183" alt="Visa">
            <img src="//evamats.pl/cdn/shop/files/mc.svg?v=958221531624973740" alt="Mastercard">
            <img src="//evamats.pl/cdn/shop/files/ae.svg?v=11463340212238954342" alt="American Express">
            <img src="//evamats.pl/cdn/shop/files/discover.svg?v=12189669757758525881" alt="Discover">
            <img src="//evamats.pl/cdn/shop/files/jcb.svg?v=12112035107271114096" alt="JCB">
            <img src="//evamats.pl/cdn/shop/files/dc.svg?v=741589216691534981" alt="Diners Club">
            <img src="//evamats.pl/cdn/shop/files/apay.svg?v=13535909208516897673" alt="Apple Pay">
            <img src="//evamats.pl/cdn/shop/files/gpay.svg?v=1292367989840229906" alt="Google Pay">
            <img src="//evamats.pl/cdn/shop/files/p24.svg?v=8919396927708048335" alt="Przelewy24">
            <img src="//evamats.pl/cdn/shop/files/blik.svg?v=1690822377707387874" alt="BLIK">
          </div>
        </div>
      </form>
    </div>
  </div>

  <div class="ecm-body">
    <div class="ecm-body-gallery">
      {%- if product.images.size > 0 -%}
        <div class="ecm-gallery" data-ecm-gallery>
          <div class="ecm-gallery-layout">
            <div class="ecm-gallery-rail">
              <button type="button" class="ecm-gallery-arrow ecm-gallery-arrow--prev" data-ecm-gallery-prev aria-label="{{ txt_gallery_prev | escape }}">‹</button>
              <div class="ecm-thumbs" data-ecm-thumbs></div>
              <button type="button" class="ecm-gallery-arrow ecm-gallery-arrow--next" data-ecm-gallery-next aria-label="{{ txt_gallery_next | escape }}">›</button>
            </div>
            <div class="ecm-gallery-main" data-ecm-gallery-main>
              <img src="{{ product.images.first | image_url: width: 1600 }}" alt="{{ product.title | escape }}" data-ecm-main-img>
            </div>
          </div>
        </div>
        <script type="application/json" data-ecm-gallery-json>
        [
          {%- for image in product.images -%}
            {"src":{{ image | image_url: width: 1800 | json }},"thumb":{{ image | image_url: width: 360 | json }},"alt":{{ image.alt | default: product.title | json }}}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
        </script>
      {%- else -%}
        <div class="ecm-gallery-main ecm-gallery-empty"><span>{{ txt_gallery_empty }}</span></div>
      {%- endif -%}
    </div>

    <div class="ecm-desc" data-ecm-desc>
      <div class="ecm-desc-tabs" role="tablist">
        <button type="button" class="ecm-desc-tab is-active" data-ecm-desc-tab="about">{{ txt_tab_about }}</button>
        <button type="button" class="ecm-desc-tab" data-ecm-desc-tab="specs">{{ txt_tab_specs }}</button>
        <button type="button" class="ecm-desc-tab" data-ecm-desc-tab="faq">{{ txt_tab_faq }}</button>
        <button type="button" class="ecm-desc-tab" data-ecm-desc-tab="shipping">{{ txt_tab_shipping }}</button>
      </div>
      <div class="ecm-desc-panel is-active" data-ecm-desc-panel="about">{% if ecm_opis != blank %}{{ ecm_opis }}{% else %}{{ product.description }}{% endif %}</div>
      <div class="ecm-desc-panel" data-ecm-desc-panel="specs">{{ ecm_tech }}</div>
      <div class="ecm-desc-panel" data-ecm-desc-panel="faq">
        {%- case ecm_locale -%}
          {%- when 'cs' -%}
            <h2>Často kladené otázky</h2>
            <h3>Budou autokoberce pasovat do mého vozu?</h3><p>Ano. Každou sadu vyrábíme podle zvolené značky, modelu, generace a karoserie.</p>
            <h3>Jak autokoberce čistit?</h3><p>Stačí je vysát nebo jemně vyklepat. Při silnějším znečištění použijte šetrný prostředek na textilie a nechte je volně uschnout.</p>
            <h3>Jak dlouho trvá výroba?</h3><p>Aktuální předpokládanou dobu výroby a dostupné možnosti dopravy uvidíte před dokončením objednávky.</p>
          {%- when 'de' -%}
            <h2>Häufige Fragen</h2>
            <h3>Passen die Fußmatten in mein Fahrzeug?</h3><p>Ja. Jedes Set wird passend zur ausgewählten Marke, zum Modell, zur Generation und zur Karosserie gefertigt.</p>
            <h3>Wie werden die Fußmatten gereinigt?</h3><p>Absaugen oder vorsichtig ausklopfen genügt meist. Bei stärkeren Verschmutzungen ein mildes Textilreinigungsmittel verwenden und an der Luft trocknen lassen.</p>
            <h3>Wie lange dauert die Fertigung?</h3><p>Die aktuelle voraussichtliche Fertigungszeit und die verfügbaren Versandarten werden vor Abschluss der Bestellung angezeigt.</p>
          {%- else -%}
            <h2>Frequently asked questions</h2>
            <h3>Will the mats fit my vehicle?</h3><p>Yes. Every set is made for the selected make, model, generation and body style.</p>
            <h3>How should I clean the mats?</h3><p>Vacuum or gently shake them out. For heavier dirt, use a mild textile cleaner and allow the mats to air-dry.</p>
            <h3>How long does production take?</h3><p>The current estimated production time and available delivery methods are shown before the order is completed.</p>
