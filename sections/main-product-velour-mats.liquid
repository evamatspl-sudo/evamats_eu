{%- assign ecm_locale = request.locale.iso_code | split: '-' | first -%}
{%- case ecm_locale -%}
  {%- when 'cs' -%}
  {%- when 'de' -%}
  {%- else -%}{%- assign ecm_locale = 'en' -%}
{%- endcase -%}
{%- assign ecm_opis = '' -%}
{%- assign ecm_tech = '' -%}
{%- if product.description contains '<!-- EVAMATS_OPIS_START -->' and product.description contains '<!-- EVAMATS_OPIS_END -->' -%}
  {%- assign _o = product.description | split: '<!-- EVAMATS_OPIS_START -->' -%}
  {%- assign _o = _o[1] | split: '<!-- EVAMATS_OPIS_END -->' -%}
  {%- assign ecm_opis = _o[0] | strip -%}
{%- endif -%}
{%- if product.description contains '<!-- EVAMATS_TECH_START -->' and product.description contains '<!-- EVAMATS_TECH_END -->' -%}
  {%- assign _t = product.description | split: '<!-- EVAMATS_TECH_START -->' -%}
  {%- assign _t = _t[1] | split: '<!-- EVAMATS_TECH_END -->' -%}
  {%- assign ecm_tech = _t[0] | strip -%}
{%- endif -%}
{%- case ecm_locale -%}
  {%- when 'cs' -%}
    {%- assign ecm_opis = ecm_opis | replace: '<strong>Měkký a hustý prémiový velur</strong>', '🧶 <strong>Měkký a hustý prémiový velur</strong>' | replace: '<strong>Účinná ochrana podlahy</strong>', '🛡️ <strong>Účinná ochrana podlahy</strong>' | replace: '<strong>Textilní lemování v několika barvách</strong>', '🎨 <strong>Textilní lemování v několika barvách</strong>' | replace: '<strong>Výroba na míru</strong>', '📐 <strong>Výroba na míru</strong>' | replace: '<strong>Stabilní upevnění</strong>', '🧲 <strong>Stabilní upevnění</strong>' | replace: '<strong>Snadná údržba</strong>', '🧹 <strong>Snadná údržba</strong>' | replace: '<strong>Vyrobeno v Polsku</strong>', '🇵🇱 <strong>Vyrobeno v Polsku</strong>' -%}
    {%- assign ecm_tech = ecm_tech | replace: '<h2>Technické údaje</h2>', '<h2>Technické údaje 🔧</h2>' -%}
  {%- when 'de' -%}
    {%- assign ecm_opis = ecm_opis | replace: '<strong>Weicher, dichter Premium-Velours</strong>', '🧶 <strong>Weicher, dichter Premium-Velours</strong>' | replace: '<strong>Zuverlässiger Bodenschutz</strong>', '🛡️ <strong>Zuverlässiger Bodenschutz</strong>' | replace: '<strong>Textile Einfassung in mehreren Farben</strong>', '🎨 <strong>Textile Einfassung in mehreren Farben</strong>' | replace: '<strong>Maßanfertigung</strong>', '📐 <strong>Maßanfertigung</strong>' | replace: '<strong>Sicherer Halt</strong>', '🧲 <strong>Sicherer Halt</strong>' | replace: '<strong>Pflegeleicht</strong>', '🧹 <strong>Pflegeleicht</strong>' | replace: '<strong>Hergestellt in Polen</strong>', '🇵🇱 <strong>Hergestellt in Polen</strong>' -%}
    {%- assign ecm_tech = ecm_tech | replace: '<h2>Technische Daten</h2>', '<h2>Technische Daten 🔧</h2>' -%}
  {%- else -%}
    {%- assign ecm_opis = ecm_opis | replace: '<strong>Soft, dense premium velour</strong>', '🧶 <strong>Soft, dense premium velour</strong>' | replace: '<strong>Effective floor protection</strong>', '🛡️ <strong>Effective floor protection</strong>' | replace: '<strong>Fabric edging in a choice of colours</strong>', '🎨 <strong>Fabric edging in a choice of colours</strong>' | replace: '<strong>Made to measure</strong>', '📐 <strong>Made to measure</strong>' | replace: '<strong>Secure positioning</strong>', '🧲 <strong>Secure positioning</strong>' | replace: '<strong>Easy care</strong>', '🧹 <strong>Easy care</strong>' | replace: '<strong>Made in Poland</strong>', '🇵🇱 <strong>Made in Poland</strong>' -%}
    {%- assign ecm_tech = ecm_tech | replace: '<h2>Technical specifications</h2>', '<h2>Technical specifications 🔧</h2>' -%}
{%- endcase -%}

