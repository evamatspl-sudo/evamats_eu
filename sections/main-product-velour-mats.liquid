  <img src="https://cdn.shopify.com/s/files/1/0734/7988/1010/files/dpd.svg?v=1754574037" alt="DPD"> 
  <ul>
    <li>Kurier DPD (płatność online lub za pobraniem)</li>
  </ul>
</div>
<div class="product_tabs__containers_item_block">
  <img src="https://cdn.shopify.com/s/files/1/0734/7988/1010/files/gls_kurier_logo.svg?v=1783098204" alt="GLS">
  <ul>
    <li>Kurier GLS (przedpłata lub za pobraniem)</li>
  </ul>
</div>


<p><strong>Płatności online:</strong></p>
<p>
  <img src="https://cdn.shopify.com/s/files/1/0734/7988/1010/files/przelewy24_logo_svg.svg?v=1754575627" alt="Przelewy24">
  <img src="https://cdn.shopify.com/s/files/1/0734/7988/1010/files/blik_9f0af63c-fe50-41e4-9eed-8eba66188150.svg?v=1754574036" alt="BLIK">
  <img src="https://cdn.shopify.com/s/files/1/0734/7988/1010/files/PayPo_logo_kolor.svg?v=1754574985" alt="PayPo">
  <img src="https://cdn.shopify.com/s/files/1/0734/7988/1010/files/visa_f5353cf6-3937-47e8-b0d0-4dffa5d38d04.svg?v=1754574037" alt="Visa">
  <img src="https://cdn.shopify.com/s/files/1/0734/7988/1010/files/mc_e03f8da5-c6a9-4429-bc4f-800d875497b5.svg?v=1754574036" alt="Mastercard">
  <img src="https://cdn.shopify.com/s/files/1/0734/7988/1010/files/apay_01efa87d-bab1-4df5-8583-9bd84c0efe6c.svg?v=1754575856" alt="Apple Pay">
  <img src="https://cdn.shopify.com/s/files/1/0734/7988/1010/files/gpay_763ff9ab-ac05-4efa-ae2a-34b490f1dbc2.svg?v=1754574037" alt="Google Pay">
</p>

<p><strong>Bezpieczny zakup:</strong></p>
<ul>
  <li>Szyfrowane płatności</li>
  <li>Sprawdzona logistyka</li>
  <li>Stały kontakt z klientem</li>
</ul>

<p>Dziękujemy, że wybierasz polski produkt tworzony z myślą o jakości i funkcjonalności. Zadowolenie kierowców to nasz największy priorytet.</p>
      </div>
    </div>
  </div>

  <div class="ecm-lightbox" data-ecm-lightbox hidden><img data-ecm-lightbox-img src="" alt=""><button type="button" class="ecm-lightbox-close" data-ecm-lightbox-close aria-label="Zamknij">×</button></div>

  <script type="application/json" data-ecm-colors-json>
  [
    {"code":"black","label":"Czarne","badge":"CZARNY","caption":"Czarny welur · obszycie czarne","swatch":{{ 'velour-swatch-black.webp' | asset_url | json }},"preview":{{ 'velour-preview-black.webp' | asset_url | json }}},
    {"code":"red","label":"Czerwone","badge":"CZERWONY","caption":"Czarny welur · obszycie czerwone","swatch":{{ 'velour-swatch-red.webp' | asset_url | json }},"preview":{{ 'velour-preview-red.webp' | asset_url | json }}},
    {"code":"lightgrey","label":"Jasnoszare","badge":"JASNOSZARY","caption":"Czarny welur · obszycie jasnoszare","swatch":{{ 'velour-swatch-lightgrey.webp' | asset_url | json }},"preview":{{ 'velour-preview-lightgrey.webp' | asset_url | json }}},
    {"code":"darkgrey","label":"Ciemnoszare","badge":"CIEMNOSZARY","caption":"Czarny welur · obszycie ciemnoszare","swatch":{{ 'velour-swatch-darkgrey.webp' | asset_url | json }},"preview":{{ 'velour-preview-darkgrey.webp' | asset_url | json }}},
    {"code":"brown","label":"Brązowe","badge":"BRĄZOWY","caption":"Czarny welur · obszycie brązowe","swatch":{{ 'velour-swatch-brown.webp' | asset_url | json }},"preview":{{ 'velour-preview-brown.webp' | asset_url | json }}},
    {"code":"beige","label":"Beżowe","badge":"BEŻOWY","caption":"Czarny welur · obszycie beżowe","swatch":{{ 'velour-swatch-beige.webp' | asset_url | json }},"preview":{{ 'velour-preview-beige.webp' | asset_url | json }}},
    {"code":"blue","label":"Niebieskie","badge":"NIEBIESKI","caption":"Czarny welur · obszycie niebieskie","swatch":{{ 'velour-swatch-blue.webp' | asset_url | json }},"preview":{{ 'velour-preview-blue.webp' | asset_url | json }}},
    {"code":"darkblue","label":"Granatowe","badge":"GRANATOWY","caption":"Czarny welur · obszycie granatowe","swatch":{{ 'velour-swatch-darkblue.webp' | asset_url | json }},"preview":{{ 'velour-preview-darkblue.webp' | asset_url | json }}},
    {"code":"green","label":"Zielone","badge":"ZIELONY","caption":"Czarny welur · obszycie zielone","swatch":{{ 'velour-swatch-green.webp' | asset_url | json }},"preview":{{ 'velour-preview-green.webp' | asset_url | json }}},
    {"code":"orange","label":"Pomarańczowe","badge":"POMARAŃCZOWY","caption":"Czarny welur · obszycie pomarańczowe","swatch":{{ 'velour-swatch-orange.webp' | asset_url | json }},"preview":{{ 'velour-preview-orange.webp' | asset_url | json }}},
    {"code":"yellow","label":"Żółte","badge":"ŻÓŁTY","caption":"Czarny welur · obszycie żółte","swatch":{{ 'velour-swatch-yellow.webp' | asset_url | json }},"preview":{{ 'velour-preview-yellow.webp' | asset_url | json }}},
    {"code":"maroon","label":"Malinowe","badge":"MALINOWY","caption":"Czarny welur · obszycie malinowe","swatch":{{ 'velour-swatch-maroon.webp' | asset_url | json }},"preview":{{ 'velour-preview-maroon.webp' | asset_url | json }}},
    {"code":"purple","label":"Fioletowe","badge":"FIOLETOWY","caption":"Czarny welur · obszycie fioletowe","swatch":{{ 'velour-swatch-purple.webp' | asset_url | json }},"preview":{{ 'velour-preview-purple.webp' | asset_url | json }}},
    {"code":"pink","label":"Różowe","badge":"RÓŻOWY","caption":"Czarny welur · obszycie różowe","swatch":{{ 'velour-swatch-pink.webp' | asset_url | json }},"preview":{{ 'velour-preview-pink.webp' | asset_url | json }}},
    {"code":"coopper","label":"Miedziane","badge":"MIEDZIANY","caption":"Czarny welur · obszycie miedziane","swatch":{{ 'Miedziany.webp' | file_url | json }},"preview":{{ 'velour-preview-coopper.webp' | asset_url | json }}}
  ]
  </script>
</section>
<script src="{{ 'velour-mats-configurator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Velour mats configurator",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
